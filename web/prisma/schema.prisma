model Fixture {
  id                 String            @id @default(cuid())
  organizationId     String            @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  seasonId           String
  season             Season            @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  divisionId         String
  division           Division          @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  eventId            String?
  event              Event?            @relation(fields: [eventId], references: [id], onDelete: SetNull)
  // Multi-sport Entrant model (Stage B2): a fixture side is EITHER a SeasonClub (team sports) OR an
  // Entrant (individual/pair/relay sports). Both are nullable; a DB CHECK (migration
  // 20260915160000_fixture_side_entrant) requires at least one per side. Read paths resolve sides
  // through web/src/lib/sports/fixture-sides.ts rather than the raw columns.
  homeSeasonClubId   String?
  homeSeasonClub     SeasonClub?       @relation("HomeSeasonClub", fields: [homeSeasonClubId], references: [id], onDelete: Restrict)
  awaySeasonClubId   String?
  awaySeasonClub     SeasonClub?       @relation("AwaySeasonClub", fields: [awaySeasonClubId], references: [id], onDelete: Restrict)
  scheduledAt        DateTime
  venueId            String
  venue              Venue             @relation(fields: [venueId], references: [id], onDelete: Restrict)
  status             FixtureStatus     @default(SCHEDULED)
  homeScore          Int               @default(0)
  awayScore          Int               @default(0)
  winnerSeasonClubId String?
  winnerSeasonClub   SeasonClub?       @relation("WinnerSeasonClub", fields: [winnerSeasonClubId], references: [id], onDelete: SetNull)
  // Multi-sport Stage 2: entrant-side references, populated by the SeasonClub->Entrant backfill.
  // Nullable and additive; the legacy SeasonClub columns remain the source of truth until later
  // stages migrate read paths. Simple FKs with application-level same-organization guards.
  homeEntrantId      String?
  homeEntrant        Entrant?          @relation("HomeEntrant", fields: [homeEntrantId], references: [id], onDelete: SetNull)
  awayEntrantId      String?
  awayEntrant        Entrant?          @relation("AwayEntrant", fields: [awayEntrantId], references: [id], onDelete: SetNull)
  winnerEntrantId    String?
  winnerEntrant      Entrant?          @relation("WinnerEntrant", fields: [winnerEntrantId], references: [id], onDelete: SetNull)
  // Multi-sport bracket metadata. Nullable - round-robin fixtures (and pre-bracket legacy rows) have
  // no round/position. `round` is 1-based within a division; `bracketPosition` is the 1-based slot in
  // that round and drives knockout advancement (winners of positions 2k-1/2k meet at position k).
  round              Int?
  bracketPosition    Int?
  groupLabel         String?
  game               Game?
  officials          FixtureOfficial[]
  media              AthleteMedia[]
  gameVideos         GameVideo[]
  recordOrigin       RecordOrigin      @default(PRODUCTION)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  // Phase 1 Stage 5.2C: lets GameVideo.fixtureId become a composite tenant-aware FK.
  @@unique([organizationId, id])
  @@index([seasonId, divisionId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([venueId, scheduledAt])
  @@index([divisionId, round, bracketPosition])
}

