// Phase 1 Stage 5.2B-3: the three REQUIRED tenant-owned relations this model establishes are
// composite FKs (organizationId, childId) -> Parent(organizationId, id) - draftEvent, division,
// and seasonClub - since this is the exact table whose live confirm step writes permanent
// Player.seasonClubId / SeasonClub coach assignments. Same reasoning as SeasonClub's Stage 5.4B
// hardening: RLS alone cannot stop a cross-org relation (Postgres FK validation is not subject
// to RLS), so the database itself now rejects it.
//
// draftSquadId/staffId are deliberately LEFT as simple (non-composite) FKs, not hardened this
// stage: both are nullable, and Prisma/Postgres reject a composite FK with `onDelete: SetNull`
// when any column in that FK (here, organizationId) is itself non-nullable - Postgres would have
// to null out organizationId too on a referenced-row delete, violating this table's own NOT NULL
// constraint. This is the same reason SeasonClub's own nullable Staff references
// (headCoachId/assistantCoachId/teamManagerId/scoutId/fanCaptainId) were never made composite
// either - discovered here, not new to this table. The application-level guard (both ids are
// always server-resolved inside reserveNextAllocation()'s own scoped transaction, never
// client-supplied) remains the operative protection for these two relations.
model DraftAllocation {
  id                String                  @id @default(cuid())
  organizationId    String                  @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  draftEventId      String
  draftEvent        DraftEvent              @relation(fields: [organizationId, draftEventId], references: [organizationId, id], onDelete: Cascade)
  operatingMode     DraftEventOperatingMode @default(REHEARSAL)
  divisionId        String
  division          Division                @relation(fields: [organizationId, divisionId], references: [organizationId, id], onDelete: Restrict)
  subjectType       AllocationSubjectType
  draftSquadId      String?
  draftSquad        DraftSquad?             @relation(fields: [draftSquadId], references: [id], onDelete: SetNull)
  staffId           String?
  staff             Staff?                  @relation(fields: [staffId], references: [id], onDelete: SetNull)
  seasonClubId      String
  seasonClub        SeasonClub              @relation(fields: [organizationId, seasonClubId], references: [organizationId, id], onDelete: Restrict)
  sequence          Int
  status            AllocationStatus        @default(PENDING)
  randomSeed        String?
  randomMethod      String?
  candidateSnapshot Json?
  reservedAt        DateTime?
  revealedAt        DateTime?
  confirmedAt       DateTime?
  correctedAt       DateTime?
  createdById       String
  createdBy         User                    @relation("DraftAllocationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedById     String?
  confirmedBy       User?                   @relation("DraftAllocationConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  correctionReason  String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([draftEventId, operatingMode, subjectType, sequence])
  @@unique([draftEventId, operatingMode, subjectType, draftSquadId])
  @@unique([draftEventId, operatingMode, subjectType, staffId])
  @@unique([draftEventId, operatingMode, subjectType, seasonClubId, divisionId])
  @@index([draftEventId, status])
  @@index([draftEventId, operatingMode])
  @@index([seasonClubId])
}

