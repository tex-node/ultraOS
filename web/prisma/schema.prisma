model ContentJob {
  id            String           @id @default(cuid())
  templateId    String
  template      ContentTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  requestedById String
  requestedBy   User             @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  type          ContentType
  sourceType    String
  sourceId      String
  status        ContentJobStatus @default(PENDING)
  errorMessage  String?
  asset         ContentAsset?
  startedAt     DateTime?
