model User {
  id                           String                  @id @default(cuid())
  name                         String
  email                        String                  @unique
  emailVerified                DateTime?
  image                        String?
  passwordHash                 String?
  role                         UserRole                @default(FAN)
  isActive                     Boolean                 @default(true)
  roles                        UserRoleAssignment[]    @relation("AssignedUserRoles")
  rolesGranted                 UserRoleAssignment[]    @relation("GrantedUserRoles")
  staffProfile                 Staff?
  athleteProfile               Athlete?
  vendorProfile                Vendor?
  mediaProfile                 MediaProfile?
  volunteerProfile             VolunteerProfile?
  fanMemberships               FanMembership[]
  scoutReports                 ScoutReport[]           @relation("ScoutReports")
  mvpVotes                     MVPVote[]
  auditLogs                    AuditLog[]
  seatReservations             SeatReservation[]
  tickets                      Ticket[]
  orders                       Order[]
  accreditations               Accreditation[]
  applicationsSubmitted        Application[]           @relation("ApplicantApplications")
  applicationsReviewed         Application[]           @relation("ReviewedApplications")
  offlineIntakesCreated        AdminOfflineIntake[]    @relation("OfflineIntakeCreatedBy")
  draftPicksCreated            DraftPick[]             @relation("DraftPickCreatedBy")
  playersSelected              Player[]                @relation("PlayerSelectedBy")
  draftEventsCreated           DraftEvent[]            @relation("DraftEventCreatedBy")
  draftAllocationsCreated      DraftAllocation[]       @relation("DraftAllocationCreatedBy")
  draftAllocationsConfirmed    DraftAllocation[]       @relation("DraftAllocationConfirmedBy")
  performedCheckIns            CheckIn[]               @relation("CheckInOperator")
  contentJobs                  ContentJob[]
  importJobs                   ImportJob[]
  trainingSessionsCreated      TrainingSession[]
  trainingRecordsCreated       AthleteTrainingRecord[]
  mediaUploaded                AthleteMedia[]
  mediaAssetsUploaded          MediaAsset[]            @relation("MediaAssetsUploaded")
  participantDocumentsUploaded ParticipantDocument[]
  eventDebriefsCreated         EventDebrief[]          @relation("EventDebriefCreatedBy")
  eventVendorReviewsCreated    EventVendorReview[]     @relation("EventVendorReviewCreatedBy")
  eventVolunteerReviews        EventVolunteerReview[]  @relation("EventVolunteerReviewVolunteer")
  eventVolunteerReviewsCreated EventVolunteerReview[]  @relation("EventVolunteerReviewCreatedBy")
  announcementsCreated         Announcement[]          @relation("AnnouncementCreatedBy")
  wellWishesAuthored           WellWish[]              @relation("WellWishAuthor")
  wellWishesModerated          WellWish[]              @relation("WellWishModeratedBy")
  gameVideosRegistered         GameVideo[]             @relation("GameVideoRegisteredBy")
  timelineAnchorsCreated       VideoTimelineAnchor[]   @relation("VideoTimelineAnchorCreatedBy")
  courtCalibrationsCreated     CourtCalibration[]      @relation("CourtCalibrationCreatedBy")
  visionAnalysisRunsRequested  VisionAnalysisRun[]     @relation("VisionAnalysisRunRequestedBy")
  courtSpecificationsCreated   CourtSpecification[]    @relation("CourtSpecificationCreatedBy")
  recordOrigin                 RecordOrigin            @default(PRODUCTION)
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  @@index([role, isActive])
}

model UserRoleAssignment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("AssignedUserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role        UserRole
  grantedById String?
  grantedBy   User?     @relation("GrantedUserRoles", fields: [grantedById], references: [id], onDelete: SetNull)
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, role])
  @@index([role, revokedAt])
  @@index([grantedById, grantedAt])
}

model Sport {
  id           String        @id @default(cuid())
  name         String        @unique
  slug         String        @unique
  isActive     Boolean       @default(true)
  competitions Competition[]
  clubs        Club[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Competition {
  id               String            @id @default(cuid())
  sportId          String
  sport            Sport             @relation(fields: [sportId], references: [id], onDelete: Restrict)
  name             String
  slug             String
  description      String?
  isActive         Boolean           @default(true)
  divisions        Division[]
  seasons          Season[]
  contentTemplates ContentTemplate[]
  systemSettings   SystemSetting[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([sportId, name])
  @@unique([sportId, slug])
  @@index([sportId, isActive])
}

model Division {
  id                    String                @id @default(cuid())
  competitionId         String
  competition           Competition           @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  name                  String
  slug                  String
  isActive              Boolean               @default(true)
  seasonClubs           SeasonClub[]
  drafts                Draft[]
  fixtures              Fixture[]
  draftSquads           DraftSquad[]
  draftAllocations      DraftAllocation[]
  draftCoachPoolEntries DraftCoachPoolEntry[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([competitionId, name])
  @@unique([competitionId, slug])
}

model Season {
  id                    String                 @id @default(cuid())
  competitionId         String
  competition           Competition            @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  name                  String
  startDate             DateTime
  endDate               DateTime
  status                SeasonStatus           @default(DRAFT)
  seasonClubs           SeasonClub[]
  players               Player[]
  drafts                Draft[]
  events                Event[]
  fixtures              Fixture[]
  standings             Standing[]
  athleteAwards         AthleteAward[]
  scoutReports          ScoutReport[]
  draftEvents           DraftEvent[]
  draftSquads           DraftSquad[]
  systemSettings        SystemSetting[]
  launchReadinessChecks LaunchReadinessCheck[]
  trainingSessions      TrainingSession[]
  ruleSets              RuleSet[]
  courtSpecifications   CourtSpecification[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([competitionId, name])
  @@index([competitionId, status])
}

model Club {
  id                           String             @id @default(cuid())
  sportId                      String
  sport                        Sport              @relation(fields: [sportId], references: [id], onDelete: Restrict)
  name                         String
  shortName                    String
  logoUrl                      String?
  primaryColor                 String?
  secondaryColor               String?
  foundedYear                  Int?
  status                       ClubStatus         @default(ACTIVE)
  brandingStatus               ClubBrandingStatus @default(BRANDING_INCOMPLETE)
  motto                        String?
  publicBio                    String?
  officialSlogan               String?
  crowdChant                   String?
  identityKeywords             String[]           @default([])
  websiteUrl                   String?
  socialLinks                  Json?
  seasonClubs                  SeasonClub[]
  fanClub                      FanClub?
  announcementVisibilityScopes Announcement[]
  recordOrigin                 RecordOrigin       @default(PRODUCTION)
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt

  @@unique([sportId, name])
  @@unique([sportId, shortName])
  @@index([sportId, status])
}

model SeasonClub {
  id               String            @id @default(cuid())
  seasonId         String
  season           Season            @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  clubId           String
  club             Club              @relation(fields: [clubId], references: [id], onDelete: Restrict)
  divisionId       String
  division         Division          @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  headCoachId      String?
  headCoach        Staff?            @relation("HeadCoachAssignments", fields: [headCoachId], references: [id], onDelete: SetNull)
  assistantCoachId String?
  assistantCoach   Staff?            @relation("AssistantCoachAssignments", fields: [assistantCoachId], references: [id], onDelete: SetNull)
  teamManagerId    String?
  teamManager      Staff?            @relation("TeamManagerAssignments", fields: [teamManagerId], references: [id], onDelete: SetNull)
  scoutId          String?
  scout            Staff?            @relation("ScoutAssignments", fields: [scoutId], references: [id], onDelete: SetNull)
  fanCaptainId     String?
  fanCaptain       Staff?            @relation("FanCaptainAssignments", fields: [fanCaptainId], references: [id], onDelete: SetNull)
  status           SeasonClubStatus  @default(ACTIVE)
  players          Player[]
  draftPicks       DraftPick[]
  homeFixtures     Fixture[]         @relation("HomeSeasonClub")
  awayFixtures     Fixture[]         @relation("AwaySeasonClub")
  wonFixtures      Fixture[]         @relation("WinnerSeasonClub")
  gameEvents       GameEvent[]
  playerStats      PlayerStat[]
  teamStats        TeamStat[]
  gameStarters     GameStarter[]
  standing         Standing?
  draftAllocations DraftAllocation[]
  trainingSessions TrainingSession[]
  recordOrigin     RecordOrigin      @default(PRODUCTION)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([seasonId, clubId, divisionId])
  @@index([seasonId, divisionId, status])
  @@index([clubId])
}

model Athlete {
  id               String                  @id @default(cuid())
  ultraAthleteId   String?                 @unique
  userId           String?                 @unique
  user             User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName        String
  lastName         String
  gender           AthleteGender
  dateOfBirth      DateTime
  dominantHand     String
  phone            String?
  email            String?                 @unique
  emergencyContact String?
  previousTeam     String?
  photoUrl         String?
  nationality      String?
  registrations    Player[]
  awards           AthleteAward[]
  videos           AthleteVideo[]
  media            AthleteMedia[]
  documents        ParticipantDocument[]
  trainingRecords  AthleteTrainingRecord[]
  scoutReports     ScoutReport[]
  recordOrigin     RecordOrigin            @default(PRODUCTION)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([lastName, firstName])
}

model Player {
  id                         String                  @id @default(cuid())
  athleteId                  String
  athlete                    Athlete                 @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  seasonId                   String
  season                     Season                  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonClubId               String?
  seasonClub                 SeasonClub?             @relation(fields: [seasonClubId], references: [id], onDelete: SetNull)
  position                   String
  heightCm                   Int
  weightKg                   Int
  jerseyNumber               Int?
  status                     PlayerStatus            @default(REGISTERED)
  draftSelectionGroup        DraftSelectionGroup     @default(PENDING_SELECTION)
  tryoutNumber               String?
  tryoutScore                Decimal?                @db.Decimal(5, 2)
  selectionNotes             String?
  selectedAt                 DateTime?
  selectedById               String?
  selectedBy                 User?                   @relation("PlayerSelectedBy", fields: [selectedById], references: [id], onDelete: SetNull)
  draftedAt                  DateTime?
  draftPicks                 DraftPick[]
  draftSquadMembers          DraftSquadMember[]
  gameEvents                 GameEvent[]             @relation("GameEventPlayer")
  fouledInGameEvents         GameEvent[]             @relation("GameEventFouledPlayer")
  assistedGameEvents         GameEvent[]             @relation("GameEventAssist")
  substitutedOutGameEvents   GameEvent[]             @relation("GameEventSubstitutedOut")
  gameStarterEntries         GameStarter[]           @relation("GameStarterPlayer")
  playerStats                PlayerStat[]
  noveltyGameEvents          NoveltyGameEvent[]      @relation("NoveltyGameEventPlayer")
  fouledInNoveltyGameEvents  NoveltyGameEvent[]      @relation("NoveltyGameEventFouledPlayer")
  noveltyPlayerStats         NoveltyPlayerStat[]
  mvpVotes                   MVPVote[]
  trainingRecords            AthleteTrainingRecord[]
  media                      AthleteMedia[]
  announcements              Announcement[]
  // G.21: candidate identity only - never player identity itself. See VisionTrack/
  // VisionObservation doc comments.
  visionTrackCandidate       VisionTrack[]           @relation("VisionTrackPlayerCandidate")
  visionObservationCandidate VisionObservation[]     @relation("VisionObservationPlayerCandidate")
  visionSpatialSummaries     VisionSpatialSummary[]
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  @@unique([athleteId, seasonId])
  @@unique([seasonClubId, jerseyNumber])
  @@index([seasonId, status])
  @@index([seasonId, draftSelectionGroup])
  @@index([seasonClubId])
  @@index([selectedById, selectedAt])
}

model AthleteAward {
  id        String   @id @default(cuid())
  athleteId String
  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  seasonId  String?
  season    Season?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  name      String
  awardedAt DateTime
  notes     String?
  createdAt DateTime @default(now())

  @@index([athleteId, awardedAt])
  @@index([seasonId])
}

model AthleteVideo {
  id         String    @id @default(cuid())
  athleteId  String
  athlete    Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  title      String
  url        String
  provider   String?
  recordedAt DateTime?
  isPublic   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([athleteId, recordedAt])
}

model TrainingSession {
  id              String                  @id @default(cuid())
  seasonId        String?
  season          Season?                 @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  seasonClubId    String?
  seasonClub      SeasonClub?             @relation(fields: [seasonClubId], references: [id], onDelete: SetNull)
  title           String
  sessionType     TrainingSessionType
  occurredAt      DateTime
  durationMinutes Int?
  location        String?
  coachId         String?
  coach           Staff?                  @relation(fields: [coachId], references: [id], onDelete: SetNull)
  notes           String?
  recordOrigin    RecordOrigin            @default(PRODUCTION)
  createdById     String
  createdBy       User                    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  participants    AthleteTrainingRecord[]
  media           AthleteMedia[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([seasonId, occurredAt])
  @@index([seasonClubId, occurredAt])
  @@index([coachId, occurredAt])
