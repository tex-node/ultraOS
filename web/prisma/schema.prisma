enum GameEventType {
  SCORE
  REBOUND
  ASSIST
  STEAL
  BLOCK
  TURNOVER
  FOUL
  TIMEOUT
  SUBSTITUTION
  NOTE
  // Additive lifecycle/ledger event types (Ultra canonical scoring model). SCORE remains the
  // event type emitted by the existing scorer for a made shot — these are available for the
  // native ledger to use going forward without breaking any code that already filters on SCORE.
  GAME_STARTED
  PERIOD_STARTED
  PERIOD_ENDED
  GAME_ENDED
  ULTRA_TIME_STARTED
  ULTRA_TIME_ENDED
  SHOT_ATTEMPT
  SHOT_MADE
  SHOT_MISSED
  FREE_THROW_ATTEMPT
  FREE_THROW_MADE
  FREE_THROW_MISSED
  SCORE_CORRECTION
  EVENT_CORRECTION
  // Added in G.15 for the statistician console's rebound entry — split out of the coarse
  // REBOUND type (still valid and still used by the scorer console) so OREB/DREB can be
  // distinguished at the ledger level, matching PlayerStat.offensiveRebounds/defensiveRebounds.
  OFFENSIVE_REBOUND
  DEFENSIVE_REBOUND
}

enum GameEventStatus {
  ACTIVE
  VOIDED
  CORRECTED
  SUPERSEDED
}

enum FourPointQualificationMethod {
  MANUAL_SCORER_SELECTION
