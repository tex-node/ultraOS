model Game {
  id                         String             @id @default(cuid())
  organizationId             String             @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization               Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fixtureId                  String             @unique
  fixture                    Fixture            @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  status                     GameStatus         @default(NOT_STARTED)
  currentPeriod              Int                @default(1)
  clockSecondsRemaining      Int                @default(600)
  clockStartedAt             DateTime?
  // Ultra Rules Engine: 20-second shot clock, tracked the same computed-remaining way as the
  // game clock (secondsRemaining snapshot + startedAt timestamp). Manually controlled by the
  // scorer, not auto-reset on possession change.
  shotClockSecondsRemaining  Int                @default(20)
  shotClockStartedAt         DateTime?
  // Explicit, persisted Ultra Time state — not re-derived from the clock alone (see
  // GameRuleSnapshot / UltraScoringEngine docs). Set true when the ULTRA_TIME_STARTED
  // transition fires, false again on ULTRA_TIME_ENDED / period end.
  isUltraTimeActive          Boolean            @default(false)
  // Monotonic per-game counter for GameEvent.sequenceNumber; incremented atomically on write.
  nextEventSequence          Int                @default(1)
  startedAt                  DateTime?
  endedAt                    DateTime?
  events                     GameEvent[]
  playerStats                PlayerStat[]
  teamStats                  TeamStat[]
  starters                   GameStarter[]
  periodScores               GamePeriodScore[]
  mvpVotes                   MVPVote[]
  ruleSnapshot               GameRuleSnapshot?
  // Provenance for results entered via an external stats report (e.g. a FIBA/Genius Sports
  // box score) rather than this app's own live scorer — never set alongside real GameEvents
  // from the live console. Null means the game's result came from the live scorer as usual.
  // resultSource holds the specific reference (e.g. a filename); statSource is the queryable
  // category it falls under.
  resultSource               String?
  resultImportedAt           DateTime?
  statSource                 StatDataSource?
  sourceImportBatchId        String?
  // What depth of data actually exists for this game — see GameDataCapability doc comment.
  // Defaults conservatively to BOX_SCORE_ONLY; explicitly upgraded to ULTRA_NATIVE_EVENTS by
  // the live scorer's start-game path, never assumed.
  dataCapability             GameDataCapability @default(BOX_SCORE_ONLY)
  // Statistics-verification gate (G.15), separate from Fixture/Game FINAL status. Set when an
  // authorized user confirms the statistician's independently-derived score matches the
  // official score (or explicitly overrides a mismatch with a reason recorded in AuditLog).
  // Finalizing the official game result never depends on this — an Event Director can still
  // finalize with statistics unverified; this only tracks whether the box score has been
  // cross-checked.
  statisticsVerifiedAt       DateTime?
  statisticsVerifiedById     String?
  gameVideos                 GameVideo[]
  metricValues               GameMetricValue[]
  // G.22 Part VIII: which basket the HOME team attacks in period 1 - the one piece of game
  // setup this system never previously captured, needed to interpret any court coordinate
  // spatially (which half is "backcourt" vs "frontcourt" for a given team/period). Nullable and
  // never guessed; attackingBasketForPeriod() (attacking-direction.ts) derives every other
  // period's direction from this ONE explicit value via the standard basketball assumption that
  // teams switch baskets at halftime - documented there, not assumed silently. Null means
  // "unknown," and every spatial function that needs it must handle that explicitly rather than
  // defaulting to a guess.
  homeAttacksBasketFirstHalf CourtBasketSide?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
}

// A versioned, named rule configuration. New games at a Season use whichever RuleSet is
// currently linked to that Season; a game's actual rules are frozen into a GameRuleSnapshot
// at game-start time so later edits here never retroactively change a played game.
model RuleSet {
  id             String       @id @default(cuid())
  organizationId String       @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  version        Int          @default(1)
  isActive       Boolean      @default(true)
  seasonId       String?
  season         Season?      @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  // Multi-sport Stage 4 (S4.1): the sport this rule set belongs to, and its validated rule values
  // keyed by the sport definition's declared rule keys. Nullable/additive - the legacy basketball
  // columns below remain authoritative until read paths are migrated. `config` shape:
  //   { "<RULE_KEY>": number | string | boolean, ... }
  sportId        String?
  sport          Sport?       @relation(fields: [sportId], references: [id], onDelete: SetNull)
  config         Json?

  periodCount             Int @default(2)
  periodDurationSeconds   Int @default(600)
  overtimeDurationSeconds Int @default(300)
  shotClockSeconds        Int @default(20)
  clockMode               ClockMode @default(RUNNING)

  fourPointEnabled        Boolean                 @default(true)
  fourPointDefinitionType FourPointDefinitionType @default(OPPOSITE_HALF_ORIGIN)
  fourPointBaseValue      Int                     @default(4)

  ultraTimeEnabled                Boolean @default(true)
  ultraTimeStartRemainingSeconds  Int     @default(60)
  ultraTimeMultiplier             Int     @default(2)
  ultraTimeAppliesFinalPeriodOnly Boolean @default(true)

  mandatorySubstitutionEnabled Boolean                     @default(true)
  mandatorySubstitutionPeriod  Int                         @default(2)
  mandatorySubstitutionPolicy  MandatorySubstitutionPolicy @default(AT_LEAST_ONE_PER_HALF)

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  gameSnapshots GameRuleSnapshot[]

  @@index([seasonId, isActive])
}

// A frozen copy of every rule value a specific Game was played under. All fields are
// duplicated from RuleSet at snapshot-creation time (not just a foreign key) so that editing
// or even deleting the source RuleSet later can never change what an already-played game's
// rules were. ruleSetId is kept only for traceability.
model GameRuleSnapshot {
  id             String       @id @default(cuid())
  organizationId String       @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gameId         String       @unique
  game           Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  ruleSetId      String?
  ruleSet        RuleSet?     @relation(fields: [ruleSetId], references: [id], onDelete: SetNull)
  ruleSetName    String
  ruleSetVersion Int
  // Multi-sport Stage 4 (S4.2): the frozen sport definition version and its resolved rule values,
  // captured at snapshot time so a played game remains explicable even if the definition changes.
  // Nullable/additive; the legacy basketball columns below remain and are still authoritative.
  sportId           String?
  sport             Sport?  @relation(fields: [sportId], references: [id], onDelete: SetNull)
  definitionVersion Int?
  ruleValues        Json?

  periodCount             Int
  periodDurationSeconds   Int
  overtimeDurationSeconds Int
  shotClockSeconds        Int
  clockMode               ClockMode

  fourPointEnabled        Boolean
  fourPointDefinitionType FourPointDefinitionType
  fourPointBaseValue      Int

  ultraTimeEnabled                Boolean
  ultraTimeStartRemainingSeconds  Int
  ultraTimeMultiplier             Int
  ultraTimeAppliesFinalPeriodOnly Boolean

  mandatorySubstitutionEnabled Boolean
  mandatorySubstitutionPeriod  Int
  mandatorySubstitutionPolicy  MandatorySubstitutionPolicy

  createdAt DateTime @default(now())
}

// Cumulative score at the end of each period, for games where only period-level (not
// play-by-play) scoring resolution is available — e.g. an imported FIBA box score, which
// reports "Scoring by 5 Minute intervals" as one cumulative figure per half/OT period.
model GamePeriodScore {
  id             String       @id @default(cuid())
  organizationId String       @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gameId         String
  game           Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  period         Int
  label          String
  homeScore      Int
  awayScore      Int
  createdAt      DateTime     @default(now())

  @@unique([gameId, period])
}

model GameEvent {
  id                           String                        @id @default(cuid())
  organizationId               String                        @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization                 Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gameId                       String
  game                         Game                          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  // Monotonic per-game ordering, assigned from Game.nextEventSequence at write time. Lets the
  // ledger be replayed deterministically even if createdAt timestamps ever collide.
  sequenceNumber               Int?
  // Nullable: most events belong to a team, but game/period-level ledger events
  // (GAME_STARTED, ULTRA_TIME_STARTED/ENDED, PERIOD_STARTED/ENDED, GAME_ENDED) aren't
  // attributable to either side and must not be forced onto one.
  seasonClubId                 String?
  seasonClub                   SeasonClub?                   @relation(fields: [seasonClubId], references: [id], onDelete: Restrict)
  // Multi-sport Stage 2: entrant attribution, populated by the backfill; nullable and additive.
  entrantId                    String?
  entrant                      Entrant?                      @relation(fields: [entrantId], references: [id], onDelete: SetNull)
  playerId                     String?
  player                       Player?                       @relation("GameEventPlayer", fields: [playerId], references: [id], onDelete: SetNull)
  // Who was fouled - optional. Some fouls (technicals, unclear contact) don't have a
  // clearly attributable other party, so this is never required even when eventType is FOUL.
  fouledPlayerId               String?
  fouledPlayer                 Player?                       @relation("GameEventFouledPlayer", fields: [fouledPlayerId], references: [id], onDelete: SetNull)
  foulType                     FoulType?
  // NCAA-style foul depth (stats Phase 3): Class A vs Class B technicals, and who the foul was
  // assessed to - a player, the bench, or the coaching staff. technicalClass is only meaningful
  // on TECHNICAL fouls; foulTarget defaults to PLAYER for every legacy row.
  technicalClass               TechnicalClass?
  foulTarget                   FoulTarget?                   @default(PLAYER)
  // Free-throw sequencing: a foul awards N free throws (freeThrowsAwarded), and each resulting FT
  // points back at the foul via causedByEventId. Pending FTs are derived (awarded minus linked),
  // never stored counters, so voiding an FT automatically reopens its slot.
  freeThrowsAwarded            Int?
  causedByEventId              String?
  causedBy                     GameEvent?                    @relation("EventCausation", fields: [causedByEventId], references: [id], onDelete: SetNull)
  causedEvents                 GameEvent[]                   @relation("EventCausation")
  eventType                    GameEventType
  // Multi-sport Stage 6 (S6.1): the sport-definition event key (SportEventDefinition.key) and an
  // opaque sport-specific payload. Nullable/additive; the legacy `eventType` enum remains for
  // Season Zero compatibility and is mapped to `typeKey` by the backfill.
  typeKey                      String?
  data                         Json?
  points                       Int?
  // Shot provenance for Ultra Time: basePointValue is the shot actually taken (1-4),
  // multiplier is 1 normally or 2 during Ultra Time (final minute of the final half).
  // points remains the actual scoreboard delta (basePointValue * multiplier for a made
  // shot; a raw uncategorized delta for manual corrections, where both are null).
  basePointValue               Int?
  multiplier                   Int?
  // Whether the underlying shot attempt was made — null for non-shot events, or for legacy
  // rows recorded before this field existed (the old scorer only ever wrote made shots).
  made                         Boolean?
  isFourPointAttempt           Boolean                       @default(false)
  isUltraTime                  Boolean                       @default(false)
  fourPointQualificationMethod FourPointQualificationMethod?
  assistedByPlayerId           String?
  assistedByPlayer             Player?                       @relation("GameEventAssist", fields: [assistedByPlayerId], references: [id], onDelete: SetNull)
  // G.16 structured substitution model: for eventType SUBSTITUTION, `playerId` is the player
  // coming IN and `substitutedOutPlayerId` is the player going OUT of the same swap - one event
  // records the whole substitution, not two directional events with the direction encoded in
  // free text. Null for every non-substitution event type.
  substitutedOutPlayerId       String?
  substitutedOutPlayer         Player?                       @relation("GameEventSubstitutedOut", fields: [substitutedOutPlayerId], references: [id], onDelete: SetNull)
  // Shot location — all null until a scorer/AI-vision pipeline actually supplies them. Never
  // fabricated to make an older event "look" located.
  x                            Float?
  y                            Float?
  courtZone                    String?

  homeScoreBefore Int?
  awayScoreBefore Int?
  homeScoreAfter  Int?
  awayScoreAfter  Int?

  // Where this event originated (native scorer vs. an import). Distinct from Game.statSource,
  // which is the whole-game-level category — an individual event can in principle differ
  // (e.g. one manually-entered correction inside an otherwise event-derived native game).
  source        StatDataSource?
  sourceEventId String?
  createdById   String?

  status            GameEventStatus @default(ACTIVE)
  correctedAt       DateTime?
  correctedById     String?
  correctionReason  String?
  // Self-referential: a correcting event points back at the event it replaces. The original
  // event is never deleted or mutated in place — its status flips to CORRECTED/VOIDED/
  // SUPERSEDED and it stays in the ledger for a full audit trail.
  supersedesEventId String?
  supersedesEvent   GameEvent?      @relation("GameEventSupersession", fields: [supersedesEventId], references: [id], onDelete: SetNull)
  supersededBy      GameEvent[]     @relation("GameEventSupersession")

  period             Int
  clockSeconds       Int
  description        String
  createdAt          DateTime           @default(now())
  // G.21: candidate matches from the AI vision pipeline against this canonical event. A match
  // existing here is never itself a promotion into x/y/courtZone above - that stays a distinct,
  // explicitly human-audited action outside this track's scope.
  visionEventMatches VisionEventMatch[]
  metricValues       GameMetricValue[]

  @@index([gameId, createdAt])
  @@index([gameId, sequenceNumber])
  @@index([playerId])
  @@index([fouledPlayerId])
  @@index([assistedByPlayerId])
  @@index([substitutedOutPlayerId])
  @@index([status])
}

// G.16 starting-five capture (Part X). A structured, auditable record of who began the game for
// each team - required before minutes/lineup analytics can be trusted. Exactly 5 rows per
// SeasonClub per Game once confirmed; never auto-selected, never inferred from the first
// statistical event. `confirmedById`/`confirmedAt` record who attested the lineup and when,
// same audit shape as the existing mandatory-substitution confirmation.
model GameStarter {
  id             String       @id @default(cuid())
  organizationId String       @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gameId         String
  game           Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  seasonClubId   String
  seasonClub     SeasonClub   @relation(fields: [seasonClubId], references: [id], onDelete: Restrict)
  playerId       String
  player         Player       @relation("GameStarterPlayer", fields: [playerId], references: [id], onDelete: Restrict)
  confirmedById  String
  confirmedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@unique([gameId, playerId])
  @@index([gameId, seasonClubId])
}

model PlayerStat {
  id                   String       @id @default(cuid())
  organizationId       String       @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gameId               String
  game                 Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId             String
  player               Player       @relation(fields: [playerId], references: [id], onDelete: Restrict)
  seasonClubId         String
  seasonClub           SeasonClub   @relation(fields: [seasonClubId], references: [id], onDelete: Restrict)
  points               Int          @default(0)
  rebounds             Int          @default(0)
  assists              Int          @default(0)
  steals               Int          @default(0)
  blocks               Int          @default(0)
  turnovers            Int          @default(0)
  fouls                Int          @default(0)
  minutesPlayed        Int          @default(0)
  // Additive detail available from a full FIBA-style box score. Nullable — never required,
  // never inferred from `points`/`rebounds` when absent. All conventional (non-Ultra) stats.
  fieldGoalsMade       Int?
  fieldGoalsAttempted  Int?
  twoPointsMade        Int?
  twoPointsAttempted   Int?
  threePointsMade      Int?
  threePointsAttempted Int?
  freeThrowsMade       Int?
  freeThrowsAttempted  Int?
  offensiveRebounds    Int?
  defensiveRebounds    Int?
  foulsDrawn           Int?
  plusMinus            Int?
  efficiency           Int?
  didNotPlay           Boolean      @default(false)

  // Ultra-specific aggregates. NULL means NOT_CAPTURED (the source this row came from doesn't
  // support the dimension at all — e.g. every Season Zero FIBA-imported row); a real 0 means
  // it was actually measured and happened to be zero. Never conflate the two. These are
  // reproducible from the GameEvent ledger for ULTRA_NATIVE_EVENTS games — see stat-provenance
  // docs — but persisted here too for read performance and for import-derived games where no
  // ledger exists.
  fourPointsMade                Int?
  fourPointsAttempted           Int?
  assistedFourPointMakes        Int?
  unassistedFourPointMakes      Int?
  ultraTimePoints               Int?
  ultraTimeFieldGoalsMade       Int?
  ultraTimeFieldGoalsAttempted  Int?
  ultraTimeTwoPointsMade        Int?
  ultraTimeTwoPointsAttempted   Int?
  ultraTimeThreePointsMade      Int?
  ultraTimeThreePointsAttempted Int?
  ultraTimeFourPointsMade       Int?
  ultraTimeFourPointsAttempted  Int?
  ultraTimeFreeThrowsMade       Int?
  ultraTimeFreeThrowsAttempted  Int?
  ultraTimeRebounds             Int?
  ultraTimeAssists              Int?
  ultraTimeSteals               Int?
  ultraTimeTurnovers            Int?
  ultraTimeBlocks               Int?
  ultraTimeFouls                Int?
  // EVENT_DERIVED (aggregated from this game's GameEvent ledger), IMPORT_DERIVED (written
  // directly by an external-report importer), or MANUAL_ENTRY. Null only for rows written
  // before this field existed.
  statSource                    StatDataSource?

  @@unique([gameId, playerId])
  @@index([seasonClubId])
}

model TeamStat {
  id                           String       @id @default(cuid())
  organizationId               String       @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization                 Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gameId                       String
  game                         Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  seasonClubId                 String
  seasonClub                   SeasonClub   @relation(fields: [seasonClubId], references: [id], onDelete: Restrict)
  // Multi-sport Stage 2: entrant identity, populated by the backfill; nullable and additive.
  entrantId                    String?
  entrant                      Entrant?     @relation(fields: [entrantId], references: [id], onDelete: SetNull)
  points                       Int          @default(0)
  rebounds                     Int          @default(0)
  assists                      Int          @default(0)
  turnovers                    Int          @default(0)
  fouls                        Int          @default(0)
  // Additive advanced team metrics available from a full FIBA-style box score. Nullable —
  // never required, never inferred when a source doesn't report them.
  pointsFromTurnovers          Int?
  pointsInPaint                Int?
  pointsInPaintMade            Int?
  pointsInPaintAttempted       Int?
  secondChancePoints           Int?
  fastBreakPoints              Int?
  fastBreakPointsFromTurnovers Int?
  benchPoints                  Int?
  biggestLead                  Int?
  biggestScoringRun            Int?
  pointsPerPossession          Decimal?     @db.Decimal(4, 2)
  leadChanges                  Int?
  timesTied                    Int?
  timeWithLeadSeconds          Int?

  // Ultra-specific team aggregates. Same NULL = NOT_CAPTURED convention as PlayerStat above.
  fourPointsMade               Int?
  fourPointsAttempted          Int?
  ultraTimePointsFor           Int?
  ultraTimePointsAgainst       Int?
  ultraTimeFieldGoalsMade      Int?
  ultraTimeFieldGoalsAttempted Int?
  statSource                   StatDataSource?

  @@unique([gameId, seasonClubId])
}

enum StatValueType {
  COUNT
  DURATION
  DECIMAL
  PERCENTAGE
}

enum StatSubjectType {
  PLAYER
  ENTRANT
}

enum StatAggregation {
  SUM
  MAX
  MIN
  AVERAGE
  RATIO
}

// Multi-sport Stage 3 (S3.1): the catalog of statistics a sport can capture, synced from the code
// registry (web/src/lib/sports/*.ts, SportDefinition.metrics). Deliberately GLOBAL like Sport - it
// is registry-derived reference data, not tenant-owned, so it carries no organizationId and no RLS.
// Per-organization metric customization is intentionally not supported yet; adding it later means a
// tenant-scoped override table, not columns here.
model SportMetricDefinition {
  id                   String                @id @default(cuid())
  sportId              String
  sport                Sport                 @relation(fields: [sportId], references: [id], onDelete: Restrict)
  key                  String
  label                String
  valueType            StatValueType
  subject              StatSubjectType
  aggregation          StatAggregation
  category             String?
  derivedFromEventKeys String[]              @default([])
  sortOrder            Int                   @default(0)
  gameValues           GameMetricValue[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  // Same key may exist for PLAYER and ENTRANT (e.g. "points"), so uniqueness is scoped by subject.
  @@unique([sportId, subject, key])
  @@index([sportId, subject, sortOrder])
}

// Multi-sport Stage 6 (S6.2): the catalog of events a sport can record, synced from the code
// registry (SportDefinition.events). GLOBAL like Sport and SportMetricDefinition - registry-derived
// reference data with no organizationId and no RLS. The scorer console renders from this catalog,
// and GameEvent.typeKey references SportEventDefinition.key.
model SportEventDefinition {
  id              String   @id @default(cuid())
  sportId         String
  sport           Sport    @relation(fields: [sportId], references: [id], onDelete: Restrict)
  key             String
  label           String
  category        String
  scores          Boolean  @default(false)
  pointValues     Int[]    @default([])
  producesMetrics String[] @default([])
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([sportId, key])
  @@index([sportId, sortOrder])
}

// Multi-sport Stage 3 (S3.1): one measured statistic for a Game, keyed by subject (player or
// entrant) and metric definition. Tenant-owned (RLS). `subjectKey` is a never-null discriminator
// ("PLAYER:<id>" / "ENTRANT:<id>") so the uniqueness constraint is reliable despite the nullable
// playerId/entrantId FKs. `period` is 0 for a whole-game value (the current basketball projection)
// and otherwise the period it applies to. `sourceEventId`/`statSource` carry provenance exactly
// like PlayerStat/TeamStat; a ledger-derived value points back at the event it came from.
//
// This table is additive. The existing PlayerStat/TeamStat tables remain the basketball read model
// until later stages migrate reads; the compatibility projection (scripts/game-metric-backfill.ts)
// materializes legacy stats into this generic form, and scripts/game-metric-parity-check.ts proves
// the two agree.
model GameMetricValue {
  id                 String                @id @default(cuid())
  organizationId     String                @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gameId             String
  game               Game                  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  metricDefinitionId String
  metricDefinition   SportMetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Restrict)
  subjectType        StatSubjectType
  subjectKey         String
  playerId           String?
  player             Player?               @relation(fields: [playerId], references: [id], onDelete: SetNull)
  entrantId          String?
  entrant            Entrant?              @relation(fields: [entrantId], references: [id], onDelete: SetNull)
  period             Int                   @default(0)
  value              Decimal               @db.Decimal(12, 3)
  sourceEventId      String?
  sourceEvent        GameEvent?            @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)
  statSource         StatDataSource?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([organizationId, gameId, metricDefinitionId, subjectKey, period])
  @@index([organizationId, gameId, subjectType])
  @@index([organizationId, gameId, playerId])
  @@index([organizationId, gameId, entrantId])
}

model Standing {
  id              String       @id @default(cuid())
  organizationId  String       @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  seasonId        String
  season          Season       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  // Multi-sport Entrant model (Stage B4): a standing belongs to a SeasonClub (team sports) OR an
  // Entrant (individual sports). Both are nullable; a DB CHECK requires at least one. Existing rows
  // all have a SeasonClub. entrantId is unique where present (one standing per entrant).
  seasonClubId    String?      @unique
  seasonClub      SeasonClub?  @relation(fields: [seasonClubId], references: [id], onDelete: Cascade)
  entrantId       String?      @unique
  entrant         Entrant?     @relation(fields: [entrantId], references: [id], onDelete: SetNull)
  played          Int          @default(0)
  won             Int          @default(0)
  // Multi-sport Stage 5 (S5.1): outcomes beyond win/loss, plus a stored rank and the tiebreak key
  // that decided it. Additive/defaulted; basketball leaves drawn/ties/noResult at 0 and rank null
  // until the backfill computes it.
  drawn           Int          @default(0)
  ties            Int          @default(0)
  noResult        Int          @default(0)
  lost            Int          @default(0)
  pointsFor       Int          @default(0)
  pointsAgainst   Int          @default(0)
  pointDifference Int          @default(0)
  leaguePoints    Int          @default(0)
  rank            Int?
  rankTiebreak    String?
  metrics         StandingMetric[]
  updatedAt       DateTime     @updatedAt

  @@index([seasonId, leaguePoints, won, pointDifference, pointsFor])
}

// Multi-sport Stage 5 (S5.1): sport-specific standings values that do not fit the standard columns,
// such as net run rate (cricket) or set/point ratio (volleyball). Tenant-owned (RLS). One row per
// (standing, metricKey).
model StandingMetric {
  id             String       @id @default(cuid())
  organizationId String       @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  standingId     String
  standing       Standing     @relation(fields: [standingId], references: [id], onDelete: Cascade)
  metricKey      String
  value          Decimal      @db.Decimal(12, 4)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([standingId, metricKey])
  @@index([organizationId, metricKey])
}

// Exhibition/novelty teams (e.g. All-Star squads) - durable across events, deliberately
// separate from Club/SeasonClub so they never touch real league standings. Players in a
// novelty match are still real league Players; only the "team" side is a lightweight entity.
model NoveltyTeam {
  id             String              @id @default(cuid())
  organizationId String              @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  shortName      String?
  logoUrl        String?
  primaryColor   String?
  description    String?
  homeMatches    NoveltyMatch[]      @relation("HomeNoveltyTeam")
  awayMatches    NoveltyMatch[]      @relation("AwayNoveltyTeam")
  wonMatches     NoveltyMatch[]      @relation("WinnerNoveltyTeam")
  events         NoveltyGameEvent[]
  playerStats    NoveltyPlayerStat[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // Phase 1 Stage 3b: was a bare @unique - rewritten to organizationId-composite so two
  // organizations can each independently name a novelty/exhibition team the same thing. No
  // application code depended on the old bare constraint.
  @@unique([organizationId, name])
}

enum NoveltyMatchStatus {
  SCHEDULED
  LIVE
  FINAL
  CANCELLED
}

model NoveltyMatch {
  id             String             @id @default(cuid())
  organizationId String             @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  eventId        String?
  event          Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  venueId        String?
  venue          Venue?             @relation(fields: [venueId], references: [id], onDelete: SetNull)
  scheduledAt    DateTime
  status         NoveltyMatchStatus @default(SCHEDULED)
  homeTeamId     String
  homeTeam       NoveltyTeam        @relation("HomeNoveltyTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeamId     String
  awayTeam       NoveltyTeam        @relation("AwayNoveltyTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  homeScore      Int                @default(0)
  awayScore      Int                @default(0)
  winnerTeamId   String?
  winnerTeam     NoveltyTeam?       @relation("WinnerNoveltyTeam", fields: [winnerTeamId], references: [id], onDelete: SetNull)
  game           NoveltyGame?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model NoveltyGame {
  id                    String              @id @default(cuid())
  organizationId        String              @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  matchId               String              @unique
  match                 NoveltyMatch        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  status                GameStatus          @default(NOT_STARTED)
  currentPeriod         Int                 @default(1)
  clockSecondsRemaining Int                 @default(600)
  clockStartedAt        DateTime?
  startedAt             DateTime?
  endedAt               DateTime?
  events                NoveltyGameEvent[]
  playerStats           NoveltyPlayerStat[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model NoveltyGameEvent {
  id             String        @id @default(cuid())
  organizationId String        @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gameId         String
  game           NoveltyGame   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  teamId         String
  team           NoveltyTeam   @relation(fields: [teamId], references: [id], onDelete: Restrict)
  playerId       String?
  player         Player?       @relation("NoveltyGameEventPlayer", fields: [playerId], references: [id], onDelete: SetNull)
  // Who was fouled - optional, same reasoning as GameEvent.fouledPlayerId.
  fouledPlayerId String?
  fouledPlayer   Player?       @relation("NoveltyGameEventFouledPlayer", fields: [fouledPlayerId], references: [id], onDelete: SetNull)
  foulType       FoulType?
  eventType      GameEventType
  points         Int?
  period         Int
  clockSeconds   Int
  description    String
  createdAt      DateTime      @default(now())

  @@index([gameId, createdAt])
  @@index([playerId])
  @@index([fouledPlayerId])
}

model NoveltyPlayerStat {
  id             String       @id @default(cuid())
  organizationId String       @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gameId         String
  game           NoveltyGame  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId       String
  player         Player       @relation(fields: [playerId], references: [id], onDelete: Restrict)
  teamId         String
  team           NoveltyTeam  @relation(fields: [teamId], references: [id], onDelete: Restrict)
  points         Int          @default(0)
  rebounds       Int          @default(0)
  assists        Int          @default(0)
  steals         Int          @default(0)
  blocks         Int          @default(0)
  turnovers      Int          @default(0)
  fouls          Int          @default(0)

  @@unique([gameId, playerId])
  @@index([teamId])
}

model FanClub {
  id             String            @id @default(cuid())
  organizationId String            @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clubId         String            @unique
  club           Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name           String
  captainName    String
  description    String
  memberships    FanMembership[]
