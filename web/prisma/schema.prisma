model DraftAllocation {
  id                String                  @id @default(cuid())
  draftEventId      String
  draftEvent        DraftEvent              @relation(fields: [draftEventId], references: [id], onDelete: Cascade)
  operatingMode     DraftEventOperatingMode @default(REHEARSAL)
  divisionId        String
  division          Division                @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  subjectType       AllocationSubjectType
  draftSquadId      String?
  draftSquad        DraftSquad?             @relation(fields: [draftSquadId], references: [id], onDelete: SetNull)
  staffId           String?
  staff             Staff?                  @relation(fields: [staffId], references: [id], onDelete: SetNull)
  seasonClubId      String
  seasonClub        SeasonClub              @relation(fields: [seasonClubId], references: [id], onDelete: Restrict)
  sequence          Int
  status            AllocationStatus        @default(PENDING)
  randomSeed        String?
  randomMethod      String?
  candidateSnapshot Json?
  reservedAt        DateTime?
