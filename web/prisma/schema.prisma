  seasonClubs           SeasonClub[]
  players               Player[]
  drafts                Draft[]
  events                Event[]
  fixtures              Fixture[]
  standings             Standing[]
  athleteAwards         AthleteAward[]
  scoutReports          ScoutReport[]
  draftEvents           DraftEvent[]
  draftSquads           DraftSquad[]
  systemSettings        SystemSetting[]
  launchReadinessChecks LaunchReadinessCheck[]
  trainingSessions      TrainingSession[]
  ruleSets              RuleSet[]
  courtSpecifications   CourtSpecification[]
  entrants              Entrant[]
  gameControlGrants     GameControlGrant[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([competitionId, name])
  // Phase 1 Stage 5.4B: see Division's identical addition above and SeasonClub's doc comment.
  @@unique([organizationId, id])
  @@index([competitionId, status])
}

model Club {
  id                           String             @id @default(cuid())
  organizationId               String             @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization                 Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sportId                      String
  sport                        Sport              @relation(fields: [sportId], references: [id], onDelete: Restrict)
  name                         String
  shortName                    String
  logoUrl                      String?
  primaryColor                 String?
  secondaryColor               String?
  foundedYear                  Int?
  status                       ClubStatus         @default(ACTIVE)
  brandingStatus               ClubBrandingStatus @default(BRANDING_INCOMPLETE)
  motto                        String?
  publicBio                    String?
  officialSlogan               String?
  crowdChant                   String?
  identityKeywords             String[]           @default([])
  websiteUrl                   String?
  socialLinks                  Json?
  seasonClubs                  SeasonClub[]
  fanClub                      FanClub?
  announcementVisibilityScopes Announcement[]
  recordOrigin                 RecordOrigin       @default(PRODUCTION)
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt

  // Phase 1 Stage 3b: was @@unique([sportId, name/shortName]) - rewritten to organizationId so
  // two different organizations can each have a club with the same name (e.g. both could
  // independently have a "Warriors"). No application code depended on the old compound key.
  @@unique([organizationId, name])
  @@unique([organizationId, shortName])
  // Phase 1 Stage 5.4B: see Division's identical addition above and SeasonClub's doc comment.
  @@unique([organizationId, id])
  @@index([sportId, status])
}

// Phase 1 Stage 5.4B: season/club/division are composite foreign keys, not bare id references.
// Proven necessary empirically (Stage 5.2B-2's rehearsal): a bare `FOREIGN KEY (clubId)
// REFERENCES Club(id)` only checks that SOME Club row with that id exists anywhere on the
// platform - Postgres foreign key validation is not subject to row-level security, so RLS making
// a cross-org Club invisible to a SELECT does nothing to stop it being a valid FK target. Pairing
// organizationId into the FK (`FOREIGN KEY (organizationId, clubId) REFERENCES Club
// (organizationId, id)`, backed by Club's own `@@unique([organizationId, id])`) means the
// database itself now rejects a SeasonClub whose clubId belongs to a different organization than
// the SeasonClub's own - true regardless of which role performs the write, RLS policy, or
// whether the caller remembered to validate scope first. Application-level scope validation
// (clubs/actions.ts's validateSeasonClubScope) is retained regardless - it produces a clean
// domain error before this constraint would ever fire, not a raw Postgres constraint-violation
// message.
model SeasonClub {
  id               String            @id @default(cuid())
  organizationId   String            @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  seasonId         String
  season           Season            @relation(fields: [organizationId, seasonId], references: [organizationId, id], onDelete: Cascade)
  clubId           String
  club             Club              @relation(fields: [organizationId, clubId], references: [organizationId, id], onDelete: Restrict)
  divisionId       String
  division         Division          @relation(fields: [organizationId, divisionId], references: [organizationId, id], onDelete: Restrict)
  headCoachId      String?
  headCoach        Staff?            @relation("HeadCoachAssignments", fields: [headCoachId], references: [id], onDelete: SetNull)
  assistantCoachId String?
  assistantCoach   Staff?            @relation("AssistantCoachAssignments", fields: [assistantCoachId], references: [id], onDelete: SetNull)
  teamManagerId    String?
  teamManager      Staff?            @relation("TeamManagerAssignments", fields: [teamManagerId], references: [id], onDelete: SetNull)
  scoutId          String?
  scout            Staff?            @relation("ScoutAssignments", fields: [scoutId], references: [id], onDelete: SetNull)
  fanCaptainId     String?
  fanCaptain       Staff?            @relation("FanCaptainAssignments", fields: [fanCaptainId], references: [id], onDelete: SetNull)
  status           SeasonClubStatus  @default(ACTIVE)
  players          Player[]
  draftPicks       DraftPick[]
  homeFixtures     Fixture[]         @relation("HomeSeasonClub")
  awayFixtures     Fixture[]         @relation("AwaySeasonClub")
  wonFixtures      Fixture[]         @relation("WinnerSeasonClub")
  gameEvents       GameEvent[]
  playerStats      PlayerStat[]
  teamStats        TeamStat[]
  gameStarters     GameStarter[]
  standing         Standing?
  draftAllocations DraftAllocation[]
  trainingSessions TrainingSession[]
  recordOrigin     RecordOrigin      @default(PRODUCTION)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Multi-sport Stage 2: a SeasonClub is represented as exactly one TEAM Entrant.
  entrant          Entrant?

  @@unique([seasonId, clubId, divisionId])
  // Phase 1 Stage 5.2B-3: backs DraftAllocation.seasonClubId's and DraftPick.seasonClubId's
  // composite FK - see Division's identical Stage 5.4B addition for the full reasoning.
  @@unique([organizationId, id])
  @@index([seasonId, divisionId, status])
  @@index([clubId])
}

enum EntrantType {
  TEAM
  INDIVIDUAL
  PAIR
  RELAY
}

enum EntrantStatus {
  ACTIVE
  INACTIVE
  WITHDRAWN
}

enum EntrantMemberRole {
  PLAYER
  CAPTAIN
  PARTNER
  COACH
  MANAGER
}

// Multi-sport Stage 2 (S2.1/S2.2): the competing unit in a Competition/Season/Division. A team
// sport is represented by one TEAM Entrant wrapping its SeasonClub; individual sports create
// INDIVIDUAL, PAIR, or RELAY Entrants backed by EntrantMember rows. Fixtures, games, standings,
// and team-level statistics reference Entrant so every sport shares one scheduling/results model.
//
// seasonClubId is nullable (null for individual entrants) and uniquely enforced where present,
// which yields exactly one TEAM Entrant per SeasonClub. It is a simple FK with an application-level
// same-organization guard, mirroring the documented Athlete exception (Athlete lacks
// @@unique([organizationId, id])); the required organizationId/competitionId/seasonId/divisionId
// links are composite FKs so the database itself rejects a cross-organization reference.
model Entrant {
  id             String        @id @default(cuid())
  organizationId String        @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  competitionId  String
  competition    Competition   @relation(fields: [organizationId, competitionId], references: [organizationId, id], onDelete: Restrict)
  seasonId       String
  season         Season        @relation(fields: [organizationId, seasonId], references: [organizationId, id], onDelete: Cascade)
  divisionId     String
  division       Division      @relation(fields: [organizationId, divisionId], references: [organizationId, id], onDelete: Restrict)
  type           EntrantType
  name           String
  shortName      String?
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  seasonClubId   String?
  seasonClub     SeasonClub?   @relation(fields: [seasonClubId], references: [id], onDelete: Restrict)
  status         EntrantStatus @default(ACTIVE)
  seed           Int?
  members        EntrantMember[]
  homeFixtures   Fixture[]     @relation("HomeEntrant")
  awayFixtures   Fixture[]     @relation("AwayEntrant")
  wonFixtures    Fixture[]     @relation("WinnerEntrant")
  gameEvents     GameEvent[]
  standings      Standing[]
  teamStats      TeamStat[]
  metricValues   GameMetricValue[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([seasonClubId])
  @@unique([organizationId, id])
  @@index([seasonId, divisionId, status])
  @@index([organizationId, competitionId])
}

// A person on an Entrant: a roster player, captain, partner, coach, or manager. athleteId is a
// simple FK (Athlete lacks @@unique([organizationId, id])); any write must assert the athlete
// belongs to the same organization at the application layer.
model EntrantMember {
  id             String            @id @default(cuid())
  organizationId String            @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entrantId      String
  entrant        Entrant           @relation(fields: [organizationId, entrantId], references: [organizationId, id], onDelete: Cascade)
  athleteId      String
  athlete        Athlete           @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  role           EntrantMemberRole @default(PLAYER)
  order          Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, entrantId, athleteId])
  @@unique([organizationId, id])
  @@index([organizationId, entrantId, order])
}

model Athlete {
  id                       String                    @id @default(cuid())
  organizationId           String                    @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  // Phase 1 Stage 3b: ultraAthleteId and userId are deliberately LEFT as bare global @unique,
  // not rewritten to organizationId-composite like email below. Both have real call sites
  // (api-v1/identifiers.ts's public lookup, imports.ts's user-linking) that assume a single-field
  // unique lookup and would need real session-derived organization context to fix correctly -
  // that's a later stage's job (deferred again, and still deliberately not this one). As of
  // Stage 5.4A, PublicIdCounter's sequence is tenant-local (each org allocates independently),
  // so this field's platform-wide uniqueness now rests on Organization.idPrefixAthlete being
  // @unique across every organization, not on a shared global sequence - see public-ids.ts and
  // PublicIdCounter's doc comment.
  ultraAthleteId           String?                   @unique
  userId                   String?                   @unique
  user                     User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName                String
  lastName                 String
  gender                   AthleteGender
  dateOfBirth              DateTime
  dominantHand             String
  phone                    String?
  email                    String?
  emergencyContact         String?
  previousTeam             String?
  photoUrl                 String?
  nationality              String?
  registrations            Player[]
  awards                   AthleteAward[]
  videos                   AthleteVideo[]
  media                    AthleteMedia[]
  documents                ParticipantDocument[]
  registrationParticipants RegistrationParticipant[]
  trainingRecords          AthleteTrainingRecord[]
  scoutReports             ScoutReport[]
  entrantMembers            EntrantMember[]
  recordOrigin             RecordOrigin              @default(PRODUCTION)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  // Phase 1 Stage 3b: was a bare @unique - rewritten to organizationId-composite so the same
  // real email can register as an athlete in two different organizations. No application code
  // depended on the old bare constraint (verified: only a .count() filter referenced email).
  @@unique([organizationId, email])
  @@index([lastName, firstName])
}

model Player {
  id                         String                  @id @default(cuid())
  organizationId             String                  @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization               Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  athleteId                  String
  athlete                    Athlete                 @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  seasonId                   String
  season                     Season                  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonClubId               String?
  seasonClub                 SeasonClub?             @relation(fields: [seasonClubId], references: [id], onDelete: SetNull)
  position                   String
  heightCm                   Int
  weightKg                   Int
  jerseyNumber               Int?
  status                     PlayerStatus            @default(REGISTERED)
  draftSelectionGroup        DraftSelectionGroup     @default(PENDING_SELECTION)
  tryoutNumber               String?
  tryoutScore                Decimal?                @db.Decimal(5, 2)
  selectionNotes             String?
  selectedAt                 DateTime?
  selectedById               String?
  selectedBy                 User?                   @relation("PlayerSelectedBy", fields: [selectedById], references: [id], onDelete: SetNull)
  draftedAt                  DateTime?
  draftPicks                 DraftPick[]
  draftSquadMembers          DraftSquadMember[]
  gameEvents                 GameEvent[]             @relation("GameEventPlayer")
  fouledInGameEvents         GameEvent[]             @relation("GameEventFouledPlayer")
  assistedGameEvents         GameEvent[]             @relation("GameEventAssist")
  substitutedOutGameEvents   GameEvent[]             @relation("GameEventSubstitutedOut")
  gameStarterEntries         GameStarter[]           @relation("GameStarterPlayer")
  playerStats                PlayerStat[]
  noveltyGameEvents          NoveltyGameEvent[]      @relation("NoveltyGameEventPlayer")
  fouledInNoveltyGameEvents  NoveltyGameEvent[]      @relation("NoveltyGameEventFouledPlayer")
  noveltyPlayerStats         NoveltyPlayerStat[]
  mvpVotes                   MVPVote[]
  trainingRecords            AthleteTrainingRecord[]
  media                      AthleteMedia[]
  announcements              Announcement[]
  // G.21: candidate identity only - never player identity itself. See VisionTrack/
  // VisionObservation doc comments.
  visionTrackCandidate       VisionTrack[]           @relation("VisionTrackPlayerCandidate")
  visionObservationCandidate VisionObservation[]     @relation("VisionObservationPlayerCandidate")
  visionSpatialSummaries     VisionSpatialSummary[]
  metricValues               GameMetricValue[]
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  @@unique([athleteId, seasonId])
  @@unique([seasonClubId, jerseyNumber])
  // Phase 1 Stage 5.2B-3: backs DraftSquadMember.playerId's and DraftPick.playerId's composite
  // FK - see Division's identical Stage 5.4B addition for the full reasoning.
  @@unique([organizationId, id])
  @@index([seasonId, status])
  @@index([seasonId, draftSelectionGroup])
  @@index([seasonClubId])
  @@index([selectedById, selectedAt])
}

model AthleteAward {
