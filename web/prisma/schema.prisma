model Event {
  id                      String                   @id @default(cuid())
  organizationId          String                   @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name                    String
  // Event Registration v1: optional public slug, unique per organization (see @@unique below).
  // Nullable so existing events are unaffected; the public registration route only resolves
  // events that have a non-null slug.
  slug                    String?
  date                    DateTime
  venueId                 String
  // Phase 1 Stage 5.2B-4: composite tenant-aware FK - createEvent() is a live, previously
  // fully-unscoped write path (see PHASE1_STAGE5_2B4 doc) that let a client-submitted venueId
  // attach an Event to any organization's Venue with nothing to stop it. Required (not
  // nullable), onDelete stays RESTRICT - no Prisma/Postgres SetNull incompatibility here.
  venue                   Venue                    @relation(fields: [organizationId, venueId], references: [organizationId, id], onDelete: Restrict)
  seasonId                String
  season                  Season                   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  doorsOpenTime           DateTime?
  startTime               DateTime
  endTime                 DateTime?
  status                  EventStatus              @default(DRAFT)
  fixtures                Fixture[]
  seatZones               SeatZone[]
  reservations            SeatReservation[]
  accreditations          Accreditation[]
  inventories             VendorInventory[]
  orders                  Order[]
  promoCodes              PromoCode[]
  sponsorCampaigns        SponsorCampaign[]
  draftEvents             DraftEvent[]
  noveltyMatches          NoveltyMatch[]
  // Event Registration v1 (sport-neutral, tenant-owned). See the Registration* models below.
  registrationForms       RegistrationForm[]
  registrationSubmissions RegistrationSubmission[]
  debrief                 EventDebrief?
  vendorReviews           EventVendorReview[]
  volunteerReviews        EventVolunteerReview[]
  gameControlGrants       GameControlGrant[]
  recordOrigin            RecordOrigin             @default(PRODUCTION)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  // Phase 1 Stage 5.2B-4: lets SeatZone.eventId/SeatReservation.eventId/VendorInventory.eventId
  // become composite tenant-aware FKs.
  @@unique([organizationId, id])
  // Event Registration v1: org-scoped public slug. Nullable, so multiple NULL slugs are allowed
  // per organization (Postgres treats NULLs as distinct in a unique index).
  @@unique([organizationId, slug])
  @@index([seasonId, date])
  @@index([venueId, date])
}

// ============================================================================
// Event Registration v1 (sport-neutral). These models are deliberately generic:
// they configure and capture event participation (individual or team) without
// embedding any sport's scoring, timing, fixture, or standings logic. Team
// registration is folded into RegistrationSubmission (one team per submission)
// rather than a separate RegistrationTeam model - see the R1 plan.
// ============================================================================

enum RegistrationMode {
  INDIVIDUAL
  TEAM
}

enum RegistrationFormStatus {
  DRAFT
  OPEN
  CLOSED
}

enum RegistrationSubmissionStatus {
  // Draft (pre-submission) - R2 team registration workflow.
  DRAFT
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  WAITLISTED
  WITHDRAWN
}

enum RegistrationFieldType {
  TEXT
  TEXTAREA
  EMAIL
  PHONE
  NUMBER
  DATE
  SELECT
  MULTISELECT
  CHECKBOX
  CONSENT
}

enum RegistrationFieldScope {
  SUBMISSION
  PARTICIPANT
}

enum RegistrationParticipantRole {
  PARTICIPANT
  COACH
  MANAGER
}

// One registration form per event (per organization). Team/individual mode,
// open/close window, capacity, and consent requirements are configuration data,
// not code branches.
model RegistrationForm {
  id                  String                   @id @default(cuid())
  organizationId      String                   @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  eventId             String
  event               Event                    @relation(fields: [organizationId, eventId], references: [organizationId, id], onDelete: Cascade)
  title               String
  description         String?
  mode                RegistrationMode         @default(INDIVIDUAL)
  status              RegistrationFormStatus   @default(DRAFT)
  publicEnabled       Boolean                  @default(false)
  opensAt             DateTime?
  closesAt            DateTime?
  capacity            Int?
  waitlistEnabled     Boolean                  @default(false)
  minTeamSize         Int?
  maxTeamSize         Int?
  requiresConsent     Boolean                  @default(false)
  confirmationMessage String?
  // All-female team competition (R2): the sports this form collects rosters for,
  // and per-sport roster/rules configuration (JSON). Additive; existing forms
  // default to no sports configured.
  sports              RegistrationSport[]
  // Multi-sport Stage 7 (S7.1): additive, definition-linked sport identity. `sportIds` mirrors
  // `sports` against the global Sport catalog; the enum array remains authoritative until cleanup.
  sportIds            String[]                 @default([])
  sportConfig         Json?
  fields              RegistrationField[]
  submissions         RegistrationSubmission[]
  recordOrigin        RecordOrigin             @default(PRODUCTION)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  // Composite-FK parents for RegistrationField/RegistrationSubmission.
  @@unique([organizationId, id])
  @@unique([organizationId, eventId])
  @@index([organizationId, status])
}

// A single configurable question. `scope` decides whether an answer belongs on
// the submission (team/contact level) or on each participant. `conditionalOn`
// carries a minimal { key, equals } visibility rule (e.g. guardian details only
// when isMinor == true).
model RegistrationField {
  id             String                 @id @default(cuid())
  organizationId String                 @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  formId         String
  form           RegistrationForm       @relation(fields: [organizationId, formId], references: [organizationId, id], onDelete: Cascade)
  key            String
  label          String
  type           RegistrationFieldType  @default(TEXT)
  scope          RegistrationFieldScope @default(SUBMISSION)
  required       Boolean                @default(false)
  options        Json?
  validation     Json?
  conditionalOn  Json?
  sortOrder      Int                    @default(0)
  recordOrigin   RecordOrigin           @default(PRODUCTION)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, formId, key])
  @@index([organizationId, formId, sortOrder])
}

// One registration (individual or team). For TEAM mode the team itself is this
// row; roster members are RegistrationParticipant rows. `referenceNumber` is
// server-generated and organization-scoped unique. `status`, reviewer fields,
// timestamps, and organizationId are server-controlled.
model RegistrationSubmission {
  id                String                       @id @default(cuid())
  organizationId    String                       @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  formId            String
  form              RegistrationForm             @relation(fields: [organizationId, formId], references: [organizationId, id], onDelete: Restrict)
  // Derived server-side from form.eventId; never client-supplied.
  eventId           String
  event             Event                        @relation(fields: [organizationId, eventId], references: [organizationId, id], onDelete: Restrict)
  mode              RegistrationMode
  status            RegistrationSubmissionStatus @default(PENDING)
  referenceNumber   String
  applicantUserId   String?
  applicantUser     User?                        @relation("RegistrationApplicant", fields: [applicantUserId], references: [id], onDelete: SetNull)
  contactName       String?
  contactEmail      String?
  contactPhone      String?
  teamName          String?
  teamClubOrSchool  String?
  teamCategory      String?
  answers           Json?
  consentAccepted   Boolean                      @default(false)
  consentName       String?
  consentAcceptedAt DateTime?
  reviewedById      String?
  reviewedBy        User?                        @relation("RegistrationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  reviewNotes       String?
  submittedAt       DateTime?
  participants      RegistrationParticipant[]
  recordOrigin      RecordOrigin                 @default(PRODUCTION)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, referenceNumber])
  @@index([organizationId, formId, status])
  @@index([organizationId, eventId])
  @@index([organizationId, createdAt])
}

// A person on a registration: roster member, coach, or manager. Free-form
// registrant records; they are NOT required to pre-exist as Athlete. The
// optional athleteId link is a simple (non-composite) FK because Athlete lacks
// @@unique([organizationId, id]); any future link write must be application-level
// assertSameOrganization-guarded. Nothing auto-internalizes an Athlete in v1.
model RegistrationParticipant {
  id                String                         @id @default(cuid())
  organizationId    String                         @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization      Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  submissionId      String
  submission        RegistrationSubmission         @relation(fields: [organizationId, submissionId], references: [organizationId, id], onDelete: Cascade)
  role              RegistrationParticipantRole    @default(PARTICIPANT)
  fullName          String
  dateOfBirth       DateTime?
  gender            String?
  email             String?
  phone             String?
  category          String?
  clubOrSchool      String?
  jerseyNumber      Int?
  answers           Json?
  athleteId         String?
  athlete           Athlete?                       @relation(fields: [athleteId], references: [id], onDelete: SetNull)
  // Per-child guardian consent (required for every child in this competition).
  guardianName      String?
  guardianPhone     String?
  consentAccepted   Boolean                        @default(false)
  consentAcceptedAt DateTime?
  sortOrder         Int                            @default(0)
  sportMemberships  RegistrationParticipantSport[]
  recordOrigin      RecordOrigin                   @default(PRODUCTION)
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt

  @@unique([organizationId, id])
  @@index([organizationId, submissionId, sortOrder])
}

// All-female team competition (R2). The sport a child is registered for, kept
// as a membership row so ONE RegistrationParticipant (the child) can hold both a
// Volleyball and a Flag Race assignment without duplicating the person.
// Per-sport roster metadata (order/position/captain) lives here, not on the person.
enum RegistrationSport {
  VOLLEYBALL
  FLAG_RACE
}

model RegistrationParticipantSport {
  id             String                  @id @default(cuid())
  organizationId String                  @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  participantId  String
  participant    RegistrationParticipant @relation(fields: [organizationId, participantId], references: [organizationId, id], onDelete: Cascade)
  sport          RegistrationSport
  // Multi-sport Stage 7 (S7.1): the Sport catalog link. Additive/nullable; the enum `sport` above
  // remains authoritative until the enum is retired in a later cleanup stage.
  sportId        String?
  sportCatalog   Sport?                  @relation(fields: [sportId], references: [id], onDelete: Restrict)
  rosterOrder    Int                     @default(0)
  position       String?
  isCaptain      Boolean                 @default(false)
  // Volleyball active vs substitute within the same roster. Ignored for Flag Race.
  isActive       Boolean                 @default(true)
  recordOrigin   RecordOrigin            @default(PRODUCTION)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, participantId, sport])
  @@index([organizationId, sport, rosterOrder])
  @@index([organizationId, sportId])
}

// Post-event retrospective data - deliberately separate from the pre-event Runbook
// (execution checklists) and Incident (live safety/ops issues) models. This is where
// "how did it actually go" gets captured for improving the next edition.
model EventDebrief {
  id                String       @id @default(cuid())
  organizationId    String       @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  eventId           String       @unique
  event             Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actualAttendance  Int?
  weatherConditions String?
  whatWentWell      String?
  whatToImprove     String?
  generalNotes      String?
  createdById       String
  createdBy         User         @relation("EventDebriefCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model EventVendorReview {
  id              String       @id @default(cuid())
  organizationId  String       @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  eventId         String
  event           Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendorId        String
  vendor          Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  rating          Int?
  wouldInviteBack Boolean?
  notes           String?
  createdById     String
  createdBy       User         @relation("EventVendorReviewCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime     @default(now())

  @@unique([eventId, vendorId])
}

model EventVolunteerReview {
  id              String       @id @default(cuid())
  organizationId  String       @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  eventId         String
  event           Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  volunteerId     String
  volunteer       User         @relation("EventVolunteerReviewVolunteer", fields: [volunteerId], references: [id], onDelete: Cascade)
  roleDescription String?
  rating          Int?
  notes           String?
  createdById     String
  createdBy       User         @relation("EventVolunteerReviewCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime     @default(now())

  @@unique([eventId, volunteerId])
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum AnnouncementVisibility {
  PUBLIC
  FAN_ZONE_MEMBERS
  CLUB_FAN_ZONE
}

model Announcement {
  id               String                 @id @default(cuid())
  organizationId   String                 @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  playerId         String
  player           Player                 @relation(fields: [playerId], references: [id], onDelete: Cascade)
  celebrationYear  Int
  status           AnnouncementStatus     @default(DRAFT)
  visibility       AnnouncementVisibility @default(PUBLIC)
  visibilityClubId String?
  visibilityClub   Club?                  @relation(fields: [visibilityClubId], references: [id], onDelete: SetNull)
  message          String?
  publishedAt      DateTime?
  createdById      String
  createdBy        User                   @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  wellWishes       WellWish[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([playerId, celebrationYear])
  @@index([status, celebrationYear])
  @@index([visibilityClubId])
}

enum WellWishStatus {
  PENDING
  APPROVED
  REJECTED
}

model WellWish {
  id             String         @id @default(cuid())
  organizationId String         @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  announcementId String
  announcement   Announcement   @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  authorUserId   String?
  authorUser     User?          @relation("WellWishAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorName     String
  message        String
  status         WellWishStatus @default(PENDING)
  moderatedById  String?
  moderatedBy    User?          @relation("WellWishModeratedBy", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt    DateTime?
  createdAt      DateTime       @default(now())

  @@index([announcementId, status])
}

model VenueSection {
  id             String       @id @default(cuid())
  organizationId String       @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  venueId        String
  venue          Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name           String
  code           String
  capacity       Int
  isActive       Boolean      @default(true)
  seatZones      SeatZone[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([venueId, code])
  @@index([venueId, isActive])
}

model SeatZone {
  id                   String            @id @default(cuid())
  organizationId       String            @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  eventId              String
  event                Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venueSectionId       String
  venueSection         VenueSection      @relation(fields: [venueSectionId], references: [id], onDelete: Restrict)
  name                 String
  capacity             Int
  priceKobo            Int
  reservedQuantity     Int               @default(0)
  salesOpenAt          DateTime?
  salesCloseAt         DateTime?
  fanClubId            String?
  fanClub              FanClub?          @relation(fields: [fanClubId], references: [id], onDelete: SetNull)
  fanClubEarlyAccessAt DateTime?
  fanClubDiscountBps   Int               @default(0)
  isActive             Boolean           @default(true)
  // F4 ticketing depth: pass tier + validity window. Null tier = regular zone.
  passTier             PassTier?
  passValidFrom        DateTime?
  passValidTo          DateTime?
  reservations         SeatReservation[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([eventId, name])
  // Phase 1 Stage 5.2B-4: lets SeatReservation.seatZoneId become a composite tenant-aware FK.
  @@unique([organizationId, id])
  @@index([eventId, isActive])
  @@index([fanClubId])
}

model SeatReservation {
  id               String            @id @default(cuid())
  organizationId   String            @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  eventId          String
  // Phase 1 Stage 5.2B-4: composite tenant-aware FK - reserveZone() (public) previously let a
  // client-submitted eventId/seatZoneId pair reserve capacity against any organization's Event/
  // SeatZone with nothing to stop it. This is the exact "Reservation.organizationId ==
  // Zone.organizationId == Event.organizationId" invariant named in the stage plan. Both
  // required, onDelete stays CASCADE/RESTRICT.
  event            Event             @relation(fields: [organizationId, eventId], references: [organizationId, id], onDelete: Cascade)
  seatZoneId       String
  seatZone         SeatZone          @relation(fields: [organizationId, seatZoneId], references: [organizationId, id], onDelete: Restrict)
  userId           String?
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  fanClubId        String?
  fanClub          FanClub?          @relation(fields: [fanClubId], references: [id], onDelete: SetNull)
  guestName        String?
  guestEmail       String?
  guestPhone       String?
  quantity         Int               @default(1)
  unitPriceKobo    Int
  totalKobo        Int
  status           ReservationStatus @default(CONFIRMED)
  paymentStatus    PaymentStatus     @default(UNPAID)
  paymentReference String?
  paidAt           DateTime?
  // Bachs hosted checkout (F5.3): set when a checkout session is created for this
  // reservation; payment is confirmed by the collection.succeeded webhook.
  checkoutId       String?
  checkoutUrl      String?
  // F4 ticketing depth: optional promo code applied at reservation time.
  promoCodeId      String?
  promoCode        PromoCode?        @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  ticket           Ticket?
  order            Order?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Phase 1 Stage 5.2B-4: lets Ticket.reservationId become a composite tenant-aware FK.
  @@unique([organizationId, id])
  @@index([eventId, status])
  @@index([seatZoneId, status])
  @@index([userId, createdAt])
  @@index([guestEmail, createdAt])
}

model Ticket {
  id             String          @id @default(cuid())
  organizationId String          @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reservationId  String          @unique
  // Phase 1 Stage 5.2B-4: composite tenant-aware FK - reserveZone() (public) creates this
  // Ticket nested inside the SeatReservation create, always same-org by construction today, but
  // hardened anyway since "an Org A ticket must never be redeemable as an Org B ticket" (this
  // stage's named invariant) deserves a database backstop, not just current-code behavior.
  // Required, onDelete stays CASCADE.
  reservation    SeatReservation @relation(fields: [organizationId, reservationId], references: [organizationId, id], onDelete: Cascade)
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  code           String          @unique
  status         TicketStatus    @default(ACTIVE)
  issuedAt       DateTime        @default(now())
  usedAt         DateTime?
  checkIns       CheckIn[]

  // Required by Prisma for the composite @relation above (a 1:1 relation must expose the FK
  // pair as a unique constraint on the defining side) - reservationId's own bare @unique already
  // guarantees the real 1:1 cardinality, this is purely to satisfy that mechanical requirement.
  @@unique([organizationId, reservationId])
  @@index([code, status])
}

model Accreditation {
  id                 String                @id @default(cuid())
  organizationId     String                @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  // Named tenantOrganization, not organization - `organization` below is a pre-existing free-text
  // field (e.g. a press credential's employer name) and must not be renamed or removed.
  tenantOrganization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  eventId            String
  event              Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  personName         String
  email              String?
  phone              String?
  category           AccreditationCategory
  organization       String?
  roleTitle          String?
  code               String                @unique
  status             AccreditationStatus   @default(PENDING)
  approvedAt         DateTime?
  checkIns           CheckIn[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([eventId, category, status])
}

model Application {
  id                             String                         @id @default(cuid())
  organizationId                 String                         @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization                   Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  applicantUserId                String?
  applicantUser                  User?                          @relation("ApplicantApplications", fields: [applicantUserId], references: [id], onDelete: SetNull)
  type                           ApplicationType
  status                         ApplicationStatus              @default(SUBMITTED)
  submittedData                  Json
  provisioningStatus             ApplicationProvisioningStatus  @default(APPROVED_ONLY)
  coachSeasonZeroSelectionStatus CoachSeasonZeroSelectionStatus @default(PENDING)
  coachSeasonZeroDivision        CoachSeasonZeroDivision?
  provisionedUserId              String?
  provisionedAthleteId           String?
  provisionedPlayerId            String?
  provisionedStaffId             String?
  provisionedAt                  DateTime?
  recordOrigin                   RecordOrigin                   @default(APPLICATION)
  reviewedById                   String?
  reviewedBy                     User?                          @relation("ReviewedApplications", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt                     DateTime?
  notes                          String?
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt

  @@index([type, status, createdAt])
  @@index([provisioningStatus])
  @@index([applicantUserId, createdAt])
  @@index([reviewedById, reviewedAt])
}

// Participants recruited or onboarded by an administrator outside the public
// Application workflow (e.g. offline recruitment). Never backfilled with a
// fabricated Application — this model is the record of how they entered.
model AdminOfflineIntake {
  id                             String                         @id @default(cuid())
  organizationId                 String                         @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization                   Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  participantType                ApplicationType
  status                         AdminOfflineIntakeStatus       @default(DRAFT)
  fullName                       String
  email                          String?
  phone                          String?
  seasonId                       String?
  notes                          String?
  coachSeasonZeroSelectionStatus CoachSeasonZeroSelectionStatus @default(PENDING)
  coachSeasonZeroDivision        CoachSeasonZeroDivision?
  // Staged player eligibility profile (gender/dateOfBirth/dominantHand/position/heightCm/weightKg).
  // Player and Athlete both require these fields as NOT NULL, so a PLAYER-type intake stays in
  // DRAFT/READY_FOR_PROVISIONING until every key here is present — never backfilled with guesses.
  playerProfile                  Json?
  provisionedUserId              String?
  provisionedStaffId             String?
  provisionedAthleteId           String?
  provisionedPlayerId            String?
  provisionedAt                  DateTime?
  createdById                    String
  createdBy                      User                           @relation("OfflineIntakeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reason                         String?
  recordOrigin                   RecordOrigin                   @default(ADMIN_OFFLINE_INTAKE)
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt

  @@index([participantType, status, createdAt])
  @@index([email])
  @@index([phone])
}

// Phase 1 Stage 5.4A: genuinely tenant-scoped, not merely RLS-compatible. `namespace` was the
// bare primary key through Stage 5.2B-1 - a single global sequence per namespace regardless of
// organization, meaning every org's allocation silently shared and advanced the same counter.
// The real per-organization identity is the (organizationId, namespace) pair; `id` exists only
// because Prisma models need a scalar primary key, not because it carries any meaning of its
// own. Existing Neon Ultra rows were migrated in place with their `nextValue` untouched - no
// existing ultraAthleteId/ultraStaffId was renumbered or reset.
model PublicIdCounter {
  id             String       @id @default(cuid())
  organizationId String       @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  namespace      String
  nextValue      BigInt
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, namespace])
}

model PublicIdAlias {
  id             String       @id @default(cuid())
  organizationId String       @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  alias          String       @unique
  entityType     String
  entityId       String
  reason         String?
  createdAt      DateTime     @default(now())

  @@index([entityType, entityId])
}

enum PublicResourceLocatorType {
  ATHLETE
  CLUB
  EVENT
  FIXTURE
  MEDIA_ASSET
}

enum PublicTokenLocatorType {
  ORDER
  TICKET
}

enum PublicLocatorStatus {
  ACTIVE
  INACTIVE
}

// Phase 1 Stage 5.5A: global bootstrap infrastructure. This model intentionally
// has no tenant RLS policy and no Neon Ultra organizationId default. It stores
// only routing provenance needed to enter withOrganizationContext().
model PublicResourceLocator {
  id             String                    @id @default(cuid())
  resourceType   PublicResourceLocatorType
  publicKey      String
  organizationId String
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  resourceId     String
  status         PublicLocatorStatus       @default(ACTIVE)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([resourceType, publicKey])
  @@index([organizationId, resourceType, status])
  @@index([resourceType, resourceId])
}

// Phase 1 Stage 5.5A: global bootstrap infrastructure for bearer-style public
// selectors. Raw tokens stay only on their authoritative tenant-owned records.
model PublicTokenLocator {
  id             String                 @id @default(cuid())
  tokenType      PublicTokenLocatorType
  tokenHash      String
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  resourceId     String
  status         PublicLocatorStatus    @default(ACTIVE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([tokenType, tokenHash])
  @@index([organizationId, tokenType, status])
  @@index([tokenType, resourceId])
}

model ImportJob {
  id             String       @id @default(cuid())
  organizationId String       @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  type           ImportType
  status         ImportStatus @default(UPLOADED)
  fileName       String
