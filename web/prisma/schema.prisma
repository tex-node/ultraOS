// Scoped game-control grant, granted from the Access dashboard.
//
// A grant with no scope applies organization-wide; otherwise it applies to exactly one competition
// (a tournament), season or event. Authorization resolves a fixture's scope and accepts any matching
// active grant, so an admin can give someone control of one tournament without a league-wide role.
// Revocation clears nothing - revokedAt keeps the grant for audit, and readers ignore revoked rows.
model GameControlGrant {
  id             String          @id @default(cuid())
  organizationId String          @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String
  user           User            @relation("GameControlGrantee", fields: [userId], references: [id], onDelete: Cascade)
  role           GameControlRole
  competitionId  String?
  competition    Competition?    @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  seasonId       String?
  season         Season?         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  eventId        String?
  event          Event?          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  grantedById    String?
  grantedBy      User?           @relation("GameControlGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, userId, revokedAt])
  @@index([organizationId, competitionId])
  @@index([organizationId, seasonId])
  @@index([organizationId, eventId])
}

enum GameControlRole {
  EVENT_ADMIN
  GAME_CONTROLLER
  SCOREKEEPER
  STATISTICIAN
}

// How the game clock behaves. RUNNING = the clock keeps running through whistles (Ultra Basketball,
// many amateur leagues); STOPPAGE = it stops at every whistle (standard/FIBA/NBA), so the operator
// pauses and resumes around each stoppage.
enum ClockMode {
  RUNNING
  STOPPAGE
}

