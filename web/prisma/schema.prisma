model ScoutReport {
  id             String                @id @default(cuid())
  organizationId String                @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  scoutId        String
  scout          User                  @relation("ScoutReports", fields: [scoutId], references: [id], onDelete: Cascade)
  athleteId      String
  athlete        Athlete               @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  seasonId       String?
  season         Season?               @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  visibility     ScoutReportVisibility @default(PRIVATE)
  rating         Int
  report         String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([scoutId, athleteId])
  @@index([athleteId, seasonId, visibility])
