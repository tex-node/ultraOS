  textTemplate  String
  htmlTemplate  String
  isActive      Boolean      @default(true)
  version       Int          @default(1)
  jobs          ContentJob[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([competitionId, type, version])
  @@index([type, isActive])
