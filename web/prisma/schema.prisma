generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  LEAGUE_OPERATOR
  TEAM_MANAGER
  PLAYER
  COACH
  SCOUT
  OFFICIAL
  VENDOR
  MEDIA
  VOLUNTEER
  FAN
}

enum SeasonStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum ClubStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SeasonClubStatus {
  ACTIVE
  INACTIVE
  WITHDRAWN
}

enum AthleteGender {
  MALE
  FEMALE
}

enum PlayerStatus {
  REGISTERED
  VERIFIED
  COMBINE_INVITE
  DRAFT_ELIGIBLE
  DRAFTED
  UNDRAFTED
  INACTIVE
}

enum DraftSelectionGroup {
  PENDING_SELECTION
  MAIN_DRAFT
  SECONDARY_DRAFT
  NOT_SELECTED
}

enum DraftTier {
  MAIN
  SECONDARY
}

enum StaffRole {
  HEAD_COACH
  ASSISTANT_COACH
  SCOUT
  OFFICIAL
  TEAM_MANAGER
  FAN_CAPTAIN
  VOLUNTEER
}

enum DraftStatus {
  NOT_STARTED
  LIVE
  PAUSED
  COMPLETED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FixtureStatus {
  SCHEDULED
  LIVE
  FINAL
  CANCELLED
}

enum GameStatus {
  NOT_STARTED
  LIVE
  PAUSED
  FINAL
}

enum GameEventType {
  SCORE
  REBOUND
  ASSIST
  STEAL
  BLOCK
  TURNOVER
  FOUL
  TIMEOUT
  SUBSTITUTION
  NOTE
}

enum ScoutReportVisibility {
  PRIVATE
  CLUB
  LEAGUE
  PUBLIC
}

enum AccreditationCategory {
  PLAYER
  COACH
  OFFICIAL
  MEDIA
  VIP_GUEST
  FAN
}

enum AccreditationStatus {
  PENDING
  APPROVED
  REVOKED
}

enum ApplicationType {
  PLAYER
  COACH
  SCOUT
  OFFICIAL
  MEDIA
  VENDOR
  VOLUNTEER
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
}

enum ProductCategory {
  SOFT_DRINK
  WATER
  ENERGY_DRINK
  POPCORN
  HOTDOG
  BURGER
  PIZZA
  MERCHANDISE
  OTHER
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  READY
  COLLECTED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CheckInType {
  VENUE_ENTRY
  ACCREDITATION
  ORDER_COLLECTION
}

enum ContentType {
  DRAFT_ANNOUNCEMENT
  FIXTURE_ANNOUNCEMENT
  RESULT_ANNOUNCEMENT
  MVP_ANNOUNCEMENT
  STANDINGS_UPDATE
  SPONSOR_REPORT
  FAN_CLUB_REPORT
}

enum ContentJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                String            @id @default(cuid())
  name              String
  email             String            @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String?
  role              UserRole          @default(FAN)
  isActive          Boolean           @default(true)
  roles             UserRoleAssignment[] @relation("AssignedUserRoles")
  rolesGranted      UserRoleAssignment[] @relation("GrantedUserRoles")
  staffProfile      Staff?
  athleteProfile    Athlete?
  vendorProfile     Vendor?
  mediaProfile      MediaProfile?
  volunteerProfile  VolunteerProfile?
  fanMemberships    FanMembership[]
  scoutReports      ScoutReport[]     @relation("ScoutReports")
  mvpVotes          MVPVote[]
  auditLogs         AuditLog[]
  seatReservations  SeatReservation[]
  tickets           Ticket[]
  orders            Order[]
  accreditations    Accreditation[]
  applicationsSubmitted Application[]     @relation("ApplicantApplications")
  applicationsReviewed  Application[]     @relation("ReviewedApplications")
  playersSelected        Player[]          @relation("PlayerSelectedBy")
  performedCheckIns CheckIn[]         @relation("CheckInOperator")
  contentJobs       ContentJob[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([role, isActive])
}

model UserRoleAssignment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("AssignedUserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role        UserRole
  grantedById String?
  grantedBy   User?    @relation("GrantedUserRoles", fields: [grantedById], references: [id], onDelete: SetNull)
  grantedAt   DateTime @default(now())
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, role])
  @@index([role, revokedAt])
  @@index([grantedById, grantedAt])
}

model Sport {
  id           String        @id @default(cuid())
  name         String        @unique
  slug         String        @unique
  isActive     Boolean       @default(true)
  competitions Competition[]
  clubs        Club[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Competition {
  id               String            @id @default(cuid())
  sportId          String
  sport            Sport             @relation(fields: [sportId], references: [id], onDelete: Restrict)
  name             String
  slug             String
  description      String?
  isActive         Boolean           @default(true)
  divisions        Division[]
  seasons          Season[]
  contentTemplates ContentTemplate[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([sportId, name])
  @@unique([sportId, slug])
  @@index([sportId, isActive])
}

model Division {
  id            String       @id @default(cuid())
  competitionId String
  competition   Competition  @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  name          String
  slug          String
  isActive      Boolean      @default(true)
  seasonClubs   SeasonClub[]
  drafts        Draft[]
  fixtures      Fixture[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([competitionId, name])
  @@unique([competitionId, slug])
}

model Season {
  id            String         @id @default(cuid())
  competitionId String
  competition   Competition    @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  name          String
  startDate     DateTime
  endDate       DateTime
  status        SeasonStatus   @default(DRAFT)
  seasonClubs   SeasonClub[]
  players       Player[]
  drafts        Draft[]
  events        Event[]
  fixtures      Fixture[]
  standings     Standing[]
  athleteAwards AthleteAward[]
  scoutReports  ScoutReport[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([competitionId, name])
  @@index([competitionId, status])
}

model Club {
  id             String       @id @default(cuid())
  sportId        String
  sport          Sport        @relation(fields: [sportId], references: [id], onDelete: Restrict)
  name           String
  shortName      String
  logoUrl        String?
  primaryColor   String
  secondaryColor String
  foundedYear    Int?
  status         ClubStatus   @default(ACTIVE)
  websiteUrl     String?
  socialLinks    Json?
  seasonClubs    SeasonClub[]
  fanClub        FanClub?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([sportId, name])
  @@unique([sportId, shortName])
  @@index([sportId, status])
}

model SeasonClub {
  id               String           @id @default(cuid())
  seasonId         String
  season           Season           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  clubId           String
  club             Club             @relation(fields: [clubId], references: [id], onDelete: Restrict)
  divisionId       String
  division         Division         @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  headCoachId      String?
  headCoach        Staff?           @relation("HeadCoachAssignments", fields: [headCoachId], references: [id], onDelete: SetNull)
  assistantCoachId String?
  assistantCoach   Staff?           @relation("AssistantCoachAssignments", fields: [assistantCoachId], references: [id], onDelete: SetNull)
  teamManagerId    String?
  teamManager      Staff?           @relation("TeamManagerAssignments", fields: [teamManagerId], references: [id], onDelete: SetNull)
  scoutId          String?
  scout            Staff?           @relation("ScoutAssignments", fields: [scoutId], references: [id], onDelete: SetNull)
  fanCaptainId     String?
  fanCaptain       Staff?           @relation("FanCaptainAssignments", fields: [fanCaptainId], references: [id], onDelete: SetNull)
  status           SeasonClubStatus @default(ACTIVE)
  players          Player[]
  draftPicks       DraftPick[]
  homeFixtures     Fixture[]        @relation("HomeSeasonClub")
  awayFixtures     Fixture[]        @relation("AwaySeasonClub")
  wonFixtures      Fixture[]        @relation("WinnerSeasonClub")
  gameEvents       GameEvent[]
  playerStats      PlayerStat[]
  teamStats        TeamStat[]
  standing         Standing?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([seasonId, clubId, divisionId])
  @@index([seasonId, divisionId, status])
  @@index([clubId])
}

model Athlete {
  id               String         @id @default(cuid())
  userId           String?        @unique
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName        String
  lastName         String
  gender           AthleteGender
  dateOfBirth      DateTime
  dominantHand     String
  phone            String?
  email            String?        @unique
  emergencyContact String?
  previousTeam     String?
  photoUrl         String?
  nationality      String?
  registrations    Player[]
  awards           AthleteAward[]
  videos           AthleteVideo[]
  scoutReports     ScoutReport[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([lastName, firstName])
}

model Player {
  id                  String              @id @default(cuid())
  athleteId           String
  athlete             Athlete             @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  seasonId            String
  season              Season              @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonClubId        String?
  seasonClub          SeasonClub?         @relation(fields: [seasonClubId], references: [id], onDelete: SetNull)
  position            String
  heightCm            Int
  weightKg            Int
  jerseyNumber        Int?
  status              PlayerStatus        @default(REGISTERED)
  draftSelectionGroup DraftSelectionGroup @default(PENDING_SELECTION)
  tryoutNumber        String?
  tryoutScore         Decimal?            @db.Decimal(5, 2)
  selectionNotes      String?
  selectedAt          DateTime?
  selectedById        String?
  selectedBy          User?               @relation("PlayerSelectedBy", fields: [selectedById], references: [id], onDelete: SetNull)
  draftedAt           DateTime?
  draftPicks          DraftPick[]
  gameEvents          GameEvent[]
  playerStats         PlayerStat[]
  mvpVotes            MVPVote[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([athleteId, seasonId])
  @@unique([seasonClubId, jerseyNumber])
  @@index([seasonId, status])
  @@index([seasonId, draftSelectionGroup])
  @@index([seasonClubId])
  @@index([selectedById, selectedAt])
}

model AthleteAward {
  id        String   @id @default(cuid())
  athleteId String
  athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  seasonId  String?
  season    Season?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  name      String
  awardedAt DateTime
  notes     String?
  createdAt DateTime @default(now())

  @@index([athleteId, awardedAt])
  @@index([seasonId])
}

model AthleteVideo {
  id         String    @id @default(cuid())
  athleteId  String
  athlete    Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  title      String
  url        String
  provider   String?
  recordedAt DateTime?
  isPublic   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([athleteId, recordedAt])
}

model Staff {
  id                        String       @id @default(cuid())
  name                      String
  role                      StaffRole
  phone                     String?
  email                     String?
  userId                    String?      @unique
  user                      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  headCoachAssignments      SeasonClub[] @relation("HeadCoachAssignments")
  assistantCoachAssignments SeasonClub[] @relation("AssistantCoachAssignments")
  teamManagerAssignments    SeasonClub[] @relation("TeamManagerAssignments")
  scoutAssignments          SeasonClub[] @relation("ScoutAssignments")
  fanCaptainAssignments     SeasonClub[] @relation("FanCaptainAssignments")
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  @@index([role])
}

model Draft {
  id             String      @id @default(cuid())
  name           String
  seasonId       String
  season         Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  divisionId     String
  division       Division    @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  tier           DraftTier   @default(MAIN)
  status         DraftStatus @default(NOT_STARTED)
  currentRound   Int         @default(1)
  nextPickNumber Int         @default(1)
  startedAt      DateTime?
  completedAt    DateTime?
  picks          DraftPick[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([seasonId, divisionId, name])
  @@index([seasonId, divisionId, tier, status])
}

model DraftPick {
  id           String     @id @default(cuid())
  draftId      String
  draft        Draft      @relation(fields: [draftId], references: [id], onDelete: Cascade)
  round        Int
  pickNumber   Int
  seasonClubId String
  seasonClub   SeasonClub @relation(fields: [seasonClubId], references: [id], onDelete: Restrict)
  playerId     String
  player       Player     @relation(fields: [playerId], references: [id], onDelete: Restrict)
  pickedAt     DateTime   @default(now())

  @@unique([draftId, pickNumber])
  @@unique([draftId, playerId])
  @@index([seasonClubId])
}

model Venue {
  id            String         @id @default(cuid())
  name          String
  address       String
  city          String
  capacity      Int
  contactPerson String?
  contactPhone  String?
  events        Event[]
  fixtures      Fixture[]
  sections      VenueSection[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([name, city])
}

model Event {
  id               String            @id @default(cuid())
  name             String
  date             DateTime
  venueId          String
  venue            Venue             @relation(fields: [venueId], references: [id], onDelete: Restrict)
  seasonId         String
  season           Season            @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  doorsOpenTime    DateTime?
  startTime        DateTime
  endTime          DateTime?
  status           EventStatus       @default(DRAFT)
  fixtures         Fixture[]
  seatZones        SeatZone[]
  reservations     SeatReservation[]
  accreditations   Accreditation[]
  inventories      VendorInventory[]
  orders           Order[]
  promoCodes       PromoCode[]
  sponsorCampaigns SponsorCampaign[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([seasonId, date])
  @@index([venueId, date])
}

model VenueSection {
  id        String     @id @default(cuid())
  venueId   String
  venue     Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name      String
  code      String
  capacity  Int
  isActive  Boolean    @default(true)
  seatZones SeatZone[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([venueId, code])
  @@index([venueId, isActive])
}

model SeatZone {
  id                   String            @id @default(cuid())
  eventId              String
  event                Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venueSectionId       String
  venueSection         VenueSection      @relation(fields: [venueSectionId], references: [id], onDelete: Restrict)
  name                 String
  capacity             Int
  priceKobo            Int
  reservedQuantity     Int               @default(0)
  salesOpenAt          DateTime?
  salesCloseAt         DateTime?
  fanClubId            String?
  fanClub              FanClub?          @relation(fields: [fanClubId], references: [id], onDelete: SetNull)
  fanClubEarlyAccessAt DateTime?
  fanClubDiscountBps   Int               @default(0)
  isActive             Boolean           @default(true)
  reservations         SeatReservation[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([eventId, name])
  @@index([eventId, isActive])
  @@index([fanClubId])
}

model SeatReservation {
  id               String            @id @default(cuid())
  eventId          String
  event            Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seatZoneId       String
  seatZone         SeatZone          @relation(fields: [seatZoneId], references: [id], onDelete: Restrict)
  userId           String?
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  fanClubId        String?
  fanClub          FanClub?          @relation(fields: [fanClubId], references: [id], onDelete: SetNull)
  guestName        String?
  guestEmail       String?
  guestPhone       String?
  quantity         Int               @default(1)
  unitPriceKobo    Int
  totalKobo        Int
  status           ReservationStatus @default(CONFIRMED)
  paymentStatus    PaymentStatus     @default(UNPAID)
  paymentReference String?
  paidAt           DateTime?
  ticket           Ticket?
  order            Order?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([eventId, status])
  @@index([seatZoneId, status])
  @@index([userId, createdAt])
  @@index([guestEmail, createdAt])
}

model Ticket {
  id            String          @id @default(cuid())
  reservationId String          @unique
  reservation   SeatReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  code          String          @unique
  status        TicketStatus    @default(ACTIVE)
  issuedAt      DateTime        @default(now())
  usedAt        DateTime?
  checkIns      CheckIn[]

  @@index([code, status])
}

model Accreditation {
  id           String                @id @default(cuid())
  eventId      String
  event        Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  personName   String
  email        String?
  phone        String?
  category     AccreditationCategory
  organization String?
  roleTitle    String?
  code         String                @unique
  status       AccreditationStatus   @default(PENDING)
  approvedAt   DateTime?
  checkIns     CheckIn[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([eventId, category, status])
}

model Application {
  id              String            @id @default(cuid())
  applicantUserId String?
  applicantUser   User?             @relation("ApplicantApplications", fields: [applicantUserId], references: [id], onDelete: SetNull)
  type            ApplicationType
  status          ApplicationStatus @default(SUBMITTED)
  submittedData   Json
  reviewedById    String?
  reviewedBy      User?             @relation("ReviewedApplications", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([type, status, createdAt])
  @@index([applicantUserId, createdAt])
  @@index([reviewedById, reviewedAt])
}

model Vendor {
  id          String          @id @default(cuid())
  userId      String?         @unique
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String          @unique
  contactName String?
  email       String?
  phone       String?
  logoUrl     String?
  isActive    Boolean         @default(true)
  products    VendorProduct[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model MediaProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization String
  roleTitle    String
  equipment    String?
  socialLinks  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VolunteerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  areaOfInterest String
  availability   String
  experience     String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model VendorProduct {
  id                 String            @id @default(cuid())
  vendorId           String
  vendor             Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  category           ProductCategory
  priceKobo          Int
  imageUrl           String?
  fanClubDiscountBps Int               @default(0)
  isActive           Boolean           @default(true)
  inventories        VendorInventory[]
  orderItems         OrderItem[]
  sponsorCampaigns   SponsorCampaign[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([vendorId, name])
  @@index([category, isActive])
}

model VendorInventory {
  id        String        @id @default(cuid())
  eventId   String
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  productId String
  product   VendorProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  stock     Int
  reserved  Int           @default(0)
  sold      Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([eventId, productId])
  @@index([eventId])
}

model Order {
  id               String           @id @default(cuid())
  eventId          String
  event            Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  reservationId    String?          @unique
  reservation      SeatReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  fanClubId        String?
  fanClub          FanClub?         @relation(fields: [fanClubId], references: [id], onDelete: SetNull)
  guestName        String?
  guestEmail       String?
  guestPhone       String?
  promoCodeId      String?
  promoCode        PromoCode?       @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  subtotalKobo     Int
  discountKobo     Int              @default(0)
  totalKobo        Int
  status           OrderStatus      @default(PENDING_PAYMENT)
  paymentStatus    PaymentStatus    @default(UNPAID)
  paymentReference String?
  collectionCode   String           @unique
  paidAt           DateTime?
  collectedAt      DateTime?
  items            OrderItem[]
  checkIns         CheckIn[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([eventId, status])
  @@index([userId, createdAt])
  @@index([collectionCode])
}

model OrderItem {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       VendorProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity      Int
  unitPriceKobo Int
  discountKobo  Int           @default(0)
  totalKobo     Int

  @@index([orderId])
  @@index([productId])
}

model CheckIn {
  id              String         @id @default(cuid())
  type            CheckInType
  ticketId        String?
  ticket          Ticket?        @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  accreditationId String?
  accreditation   Accreditation? @relation(fields: [accreditationId], references: [id], onDelete: SetNull)
  orderId         String?
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  checkedInById   String
  checkedInBy     User           @relation("CheckInOperator", fields: [checkedInById], references: [id], onDelete: Restrict)
  notes           String?
  checkedInAt     DateTime       @default(now())

  @@index([ticketId, checkedInAt])
  @@index([accreditationId, checkedInAt])
  @@index([orderId, checkedInAt])
}

model PromoCode {
  id                String           @id @default(cuid())
  eventId           String?
  event             Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  code              String           @unique
  description       String?
  discountBps       Int              @default(0)
  maxRedemptions    Int?
  redemptionCount   Int              @default(0)
  startsAt          DateTime?
  endsAt            DateTime?
  isActive          Boolean          @default(true)
  orders            Order[]
  sponsorCampaignId String?
  sponsorCampaign   SponsorCampaign? @relation(fields: [sponsorCampaignId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([eventId, isActive])
}

model SponsorCampaign {
  id          String         @id @default(cuid())
  name        String
  sponsorName String
  eventId     String?
  event       Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  productId   String?
  product     VendorProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  impressions Int            @default(0)
  redemptions Int            @default(0)
  unitsSold   Int            @default(0)
  revenueKobo Int            @default(0)
  promoCodes  PromoCode[]
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([eventId, isActive])
  @@index([sponsorName])
}

model Fixture {
  id                 String            @id @default(cuid())
  seasonId           String
  season             Season            @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  divisionId         String
  division           Division          @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  eventId            String?
  event              Event?            @relation(fields: [eventId], references: [id], onDelete: SetNull)
  homeSeasonClubId   String
  homeSeasonClub     SeasonClub        @relation("HomeSeasonClub", fields: [homeSeasonClubId], references: [id], onDelete: Restrict)
  awaySeasonClubId   String
  awaySeasonClub     SeasonClub        @relation("AwaySeasonClub", fields: [awaySeasonClubId], references: [id], onDelete: Restrict)
  scheduledAt        DateTime
  venueId            String
  venue              Venue             @relation(fields: [venueId], references: [id], onDelete: Restrict)
  status             FixtureStatus     @default(SCHEDULED)
  homeScore          Int               @default(0)
  awayScore          Int               @default(0)
  winnerSeasonClubId String?
  winnerSeasonClub   SeasonClub?       @relation("WinnerSeasonClub", fields: [winnerSeasonClubId], references: [id], onDelete: SetNull)
  game               Game?
  officials          FixtureOfficial[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([seasonId, divisionId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([venueId, scheduledAt])
}

model FixtureOfficial {
  id        String   @id @default(cuid())
  fixtureId String
  fixture   Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  name      String
  role      String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fixtureId, name, role])
  @@index([fixtureId])
}

model Game {
  id                    String       @id @default(cuid())
  fixtureId             String       @unique
  fixture               Fixture      @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  status                GameStatus   @default(NOT_STARTED)
  currentPeriod         Int          @default(1)
  clockSecondsRemaining Int          @default(600)
  clockStartedAt        DateTime?
  startedAt             DateTime?
  endedAt               DateTime?
  events                GameEvent[]
  playerStats           PlayerStat[]
  teamStats             TeamStat[]
  mvpVotes              MVPVote[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

model GameEvent {
  id           String        @id @default(cuid())
  gameId       String
  game         Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  seasonClubId String
  seasonClub   SeasonClub    @relation(fields: [seasonClubId], references: [id], onDelete: Restrict)
  playerId     String?
  player       Player?       @relation(fields: [playerId], references: [id], onDelete: SetNull)
  eventType    GameEventType
  points       Int?
  period       Int
  clockSeconds Int
  description  String
  createdAt    DateTime      @default(now())

  @@index([gameId, createdAt])
  @@index([playerId])
}

model PlayerStat {
  id            String     @id @default(cuid())
  gameId        String
  game          Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId      String
  player        Player     @relation(fields: [playerId], references: [id], onDelete: Restrict)
  seasonClubId  String
  seasonClub    SeasonClub @relation(fields: [seasonClubId], references: [id], onDelete: Restrict)
  points        Int        @default(0)
  rebounds      Int        @default(0)
  assists       Int        @default(0)
  steals        Int        @default(0)
  blocks        Int        @default(0)
  turnovers     Int        @default(0)
  fouls         Int        @default(0)
  minutesPlayed Int        @default(0)

  @@unique([gameId, playerId])
  @@index([seasonClubId])
}

model TeamStat {
  id           String     @id @default(cuid())
  gameId       String
  game         Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  seasonClubId String
  seasonClub   SeasonClub @relation(fields: [seasonClubId], references: [id], onDelete: Restrict)
  points       Int        @default(0)
  rebounds     Int        @default(0)
  assists      Int        @default(0)
  turnovers    Int        @default(0)
  fouls        Int        @default(0)

  @@unique([gameId, seasonClubId])
}

model Standing {
  id              String     @id @default(cuid())
  seasonId        String
  season          Season     @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonClubId    String     @unique
  seasonClub      SeasonClub @relation(fields: [seasonClubId], references: [id], onDelete: Cascade)
  played          Int        @default(0)
  won             Int        @default(0)
  lost            Int        @default(0)
  pointsFor       Int        @default(0)
  pointsAgainst   Int        @default(0)
  pointDifference Int        @default(0)
  leaguePoints    Int        @default(0)
  updatedAt       DateTime   @updatedAt

  @@index([seasonId, leaguePoints, won, pointDifference, pointsFor])
}

model FanClub {
  id           String            @id @default(cuid())
  clubId       String            @unique
  club         Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name         String
  captainName  String
  description  String
  memberships  FanMembership[]
  seatZones    SeatZone[]
  reservations SeatReservation[]
  orders       Order[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model FanMembership {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fanClubId      String
  fanClub        FanClub  @relation(fields: [fanClubId], references: [id], onDelete: Cascade)
  name           String?
  phone          String?
  whatsappNumber String?
  source         String?
  joinedAt       DateTime @default(now())

  @@unique([userId, fanClubId])
  @@index([fanClubId, phone])
}

model ScoutReport {
  id         String                @id @default(cuid())
  scoutId    String
  scout      User                  @relation("ScoutReports", fields: [scoutId], references: [id], onDelete: Cascade)
  athleteId  String
  athlete    Athlete               @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  seasonId   String?
  season     Season?               @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  visibility ScoutReportVisibility @default(PRIVATE)
  rating     Int
  report     String
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@index([scoutId, athleteId])
  @@index([athleteId, seasonId, visibility])
}

model MVPVote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, gameId])
  @@index([gameId, playerId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

model ContentTemplate {
  id            String       @id @default(cuid())
  competitionId String?
  competition   Competition? @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  type          ContentType
  name          String
  textTemplate  String
  htmlTemplate  String
  isActive      Boolean      @default(true)
  version       Int          @default(1)
  jobs          ContentJob[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([competitionId, type, version])
  @@index([type, isActive])
}

model ContentJob {
  id            String           @id @default(cuid())
  templateId    String
  template      ContentTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  requestedById String
  requestedBy   User             @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  type          ContentType
  sourceType    String
  sourceId      String
  status        ContentJobStatus @default(PENDING)
  errorMessage  String?
  asset         ContentAsset?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([sourceType, sourceId])
  @@index([requestedById, createdAt])
}

model ContentAsset {
  id          String     @id @default(cuid())
  jobId       String     @unique
  job         ContentJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  slug        String     @unique
  title       String
  textContent String
  htmlContent String
  graphicData Json
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([createdAt])
}
