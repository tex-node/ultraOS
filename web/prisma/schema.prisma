  DESIGNATED_ZONE
  DISABLED
}

enum MandatorySubstitutionPolicy {
  NONE
  AT_LEAST_ONE_PER_HALF
  FULL_ROTATION
}

// Coarse, per-game signal of what depth of data actually exists for that game — lets API
// consumers and UI know what can safely be shown (e.g. don't render a shot chart for a
// BOX_SCORE_ONLY game). Complements, not replaces, the finer null-vs-zero convention used on
// individual stat fields (see PlayerStat/TeamStat comments).
enum GameDataCapability {
  BOX_SCORE_ONLY
  PLAY_BY_PLAY
  ULTRA_NATIVE_EVENTS
  SHOT_LOCATION
  VISION_ENRICHED
}

// The category of where a game's results/stats came from. Distinct from the free-text
// resultSource/sourceReference fields (e.g. an exact filename) already on Game — this is the
// queryable category those specific references fall under.
enum StatDataSource {
  ULTRA_NATIVE_LIVE_SCORER
  FIBA_LIVESTATS_PDF_IMPORT
  GENIUS_SPORTS_IMPORT
  MANUAL_ADMIN_ENTRY
  CSV_IMPORT
  EXTERNAL_PROVIDER
  // Added in G.15: events written by the independent statistician console, distinct from
  // ULTRA_NATIVE_LIVE_SCORER (the scorer's own console). The two sources' events are compared
  // for score reconciliation precisely because they come from separately-operated consoles.
  ULTRA_NATIVE_LIVE_STATISTICIAN
  // Added in G.16: stamped on PlayerStat/TeamStat rows materialized by rebuildGameStatsFromEvents()
  // from a VERIFIED statistician GameEvent ledger - distinct from ULTRA_NATIVE_LIVE_STATISTICIAN
  // (which tags the raw events themselves) so a reader can tell "this row is a derived,
  // verified snapshot" apart from "this row was written incrementally, event-by-event."
  EVENT_DERIVED
}

