model User {
  id                           String                   @id @default(cuid())
  name                         String
  email                        String                   @unique
  emailVerified                DateTime?
  image                        String?
  passwordHash                 String?
  // Session version: bumped whenever the password changes, so every other device's JWT stops
  // matching and is signed out on its next page load (see auth.ts's session version check).
  sessionVersion               Int                    @default(0)
  role                         UserRole                 @default(FAN)
  isActive                     Boolean                  @default(true)
  roles                        UserRoleAssignment[]     @relation("AssignedUserRoles")
  rolesGranted                 UserRoleAssignment[]     @relation("GrantedUserRoles")
  gameControlGrants            GameControlGrant[]       @relation("GameControlGrantee")
  gameControlGrantsGranted     GameControlGrant[]       @relation("GameControlGrantedBy")
  staffProfile                 Staff?
  athleteProfile               Athlete?
  vendorProfile                Vendor?
  mediaProfile                 MediaProfile?
  volunteerProfile             VolunteerProfile?
  fanMemberships               FanMembership[]
  scoutReports                 ScoutReport[]            @relation("ScoutReports")
  mvpVotes                     MVPVote[]
  auditLogs                    AuditLog[]
  seatReservations             SeatReservation[]
  tickets                      Ticket[]
  orders                       Order[]
  accreditations               Accreditation[]
  applicationsSubmitted        Application[]            @relation("ApplicantApplications")
  applicationsReviewed         Application[]            @relation("ReviewedApplications")
  registrationSubmissions      RegistrationSubmission[] @relation("RegistrationApplicant")
  registrationReviews          RegistrationSubmission[] @relation("RegistrationReviewer")
  offlineIntakesCreated        AdminOfflineIntake[]     @relation("OfflineIntakeCreatedBy")
  draftPicksCreated            DraftPick[]              @relation("DraftPickCreatedBy")
  playersSelected              Player[]                 @relation("PlayerSelectedBy")
  draftEventsCreated           DraftEvent[]             @relation("DraftEventCreatedBy")
  draftAllocationsCreated      DraftAllocation[]        @relation("DraftAllocationCreatedBy")
  draftAllocationsConfirmed    DraftAllocation[]        @relation("DraftAllocationConfirmedBy")
  performedCheckIns            CheckIn[]                @relation("CheckInOperator")
  contentJobs                  ContentJob[]
  importJobs                   ImportJob[]
  trainingSessionsCreated      TrainingSession[]
  trainingRecordsCreated       AthleteTrainingRecord[]
  mediaUploaded                AthleteMedia[]
  mediaAssetsUploaded          MediaAsset[]             @relation("MediaAssetsUploaded")
  participantDocumentsUploaded ParticipantDocument[]
  eventDebriefsCreated         EventDebrief[]           @relation("EventDebriefCreatedBy")
  eventVendorReviewsCreated    EventVendorReview[]      @relation("EventVendorReviewCreatedBy")
  eventVolunteerReviews        EventVolunteerReview[]   @relation("EventVolunteerReviewVolunteer")
  eventVolunteerReviewsCreated EventVolunteerReview[]   @relation("EventVolunteerReviewCreatedBy")
  announcementsCreated         Announcement[]           @relation("AnnouncementCreatedBy")
  wellWishesAuthored           WellWish[]               @relation("WellWishAuthor")
  wellWishesModerated          WellWish[]               @relation("WellWishModeratedBy")
  gameVideosRegistered         GameVideo[]              @relation("GameVideoRegisteredBy")
  timelineAnchorsCreated       VideoTimelineAnchor[]    @relation("VideoTimelineAnchorCreatedBy")
  courtCalibrationsCreated     CourtCalibration[]       @relation("CourtCalibrationCreatedBy")
  visionAnalysisRunsRequested  VisionAnalysisRun[]      @relation("VisionAnalysisRunRequestedBy")
  courtSpecificationsCreated   CourtSpecification[]     @relation("CourtSpecificationCreatedBy")
  recordOrigin                 RecordOrigin             @default(PRODUCTION)
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt

  @@index([role, isActive])
}

model UserRoleAssignment {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation("AssignedUserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role           UserRole
  // Phase 1 multi-tenancy (see Organization doc comment below). Null = a platform-level grant
  // (e.g. SUPER_ADMIN, or today's single-tenant FAN/etc. grants before any org exists to scope
  // them to) - never assumed to mean "every organization." Non-null scopes the grant to exactly
  // one organization (e.g. a League Manager for one league only).
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grantedById    String?
  grantedBy      User?         @relation("GrantedUserRoles", fields: [grantedById], references: [id], onDelete: SetNull)
  grantedAt      DateTime      @default(now())
  revokedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([userId, role, organizationId])
  @@index([role, revokedAt])
  @@index([grantedById, grantedAt])
  @@index([organizationId, role])
}

model Sport {
  id           String        @id @default(cuid())
  name         String        @unique
  slug         String        @unique
  isActive     Boolean       @default(true)
  competitions Competition[]
  clubs        Club[]
  definitionOverrides SportDefinitionOverride[]
  metricDefinitions SportMetricDefinition[]
  eventDefinitions  SportEventDefinition[]
  ruleSets          RuleSet[]
  gameRuleSnapshots GameRuleSnapshot[]
  registrationParticipantSports RegistrationParticipantSport[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Multi-sport Stage 1 (S1.3): organization-scoped customization of a sport definition. The code
// registry (web/src/lib/sports) is the authority; this table stores only validated overrides
// (rule values and default divisions), which the resolver applies in memory on top of the
// registered definition. Sport is a global catalog with no organizationId and no RLS, so sportId
// is a plain FK; organizationId is the tenant scope (RLS + composite FK conventions from
// PHASE1_STAGE5_4B_RELATIONAL_INTEGRITY.md apply to organizationId as usual).
//
// Versioned and append-on-write: saving a change deactivates the current active row and inserts a
// new one with version = max + 1, preserving history. Exactly one row per (organizationId, sportId)
// is expected to be active at a time, but that is an application invariant, not a unique constraint,
// so a future scheduler could stage a future-dated override without conflict.
model SportDefinitionOverride {
  id             String       @id @default(cuid())
  organizationId String       @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sportId        String
  sport          Sport        @relation(fields: [sportId], references: [id], onDelete: Restrict)
  version        Int          @default(1)
  config         Json
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, sportId, version])
  @@index([organizationId, sportId, isActive])
}

model Competition {
  id               String            @id @default(cuid())
  organizationId   String            @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sportId          String
  sport            Sport             @relation(fields: [sportId], references: [id], onDelete: Restrict)
  name             String
  slug             String
  description      String?
  isActive         Boolean           @default(true)
  // Multi-sport: how fixtures in this competition are generated and whether a level score is a valid
  // final result. ROUND_ROBIN (league, draws allowed where the sport allows), KNOCKOUT (single
  // elimination; a level score must be resolved by extra time/penalties, not finalized as a draw),
  // GROUP_STAGE (seeded groups -> round-robin).
  format           CompetitionFormat @default(ROUND_ROBIN)
  // GROUP_STAGE only: the default number of groups. A division may override it.
  groupCount       Int               @default(2)
  divisions        Division[]
  seasons          Season[]
  entrants         Entrant[]
  gameControlGrants GameControlGrant[]
  contentTemplates ContentTemplate[]
  systemSettings   SystemSetting[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Phase 1 Stage 3b: was @@unique([sportId, name/slug]) - rewritten to organizationId so two
  // different organizations playing the same sport can each have their own "Season Zero"
  // competition. No application code depended on the old compound key (verified: only Prisma's
  // own generated types referenced sportId_name/sportId_slug).
  @@unique([organizationId, name])
  @@unique([organizationId, slug])
  // Multi-sport Stage 2: backs Entrant.competitionId's composite FK - see Division's identical
  // Stage 5.4B addition for the full reasoning.
  @@unique([organizationId, id])
  @@index([sportId, isActive])
}

model Division {
  id                    String                @id @default(cuid())
  organizationId        String                @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  competitionId         String
  competition           Competition           @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  name                  String
  slug                  String
  isActive              Boolean               @default(true)
  // Optional per-division override of the competition's format/group count. Null inherits from the
  // competition, so a competition can run a league in one division and a knockout in another.
  format                CompetitionFormat?
  groupCount            Int?
  seasonClubs           SeasonClub[]
  drafts                Draft[]
  fixtures              Fixture[]
  draftSquads           DraftSquad[]
  draftAllocations      DraftAllocation[]
  draftCoachPoolEntries DraftCoachPoolEntry[]
  entrants              Entrant[]
  // Knockout draws only: round-1 slots whose entrant has no first-round opponent, keyed by
  // bracketPosition ("1" -> seasonClubId|entrantId shape). Byes auto-advance, so the advancement
  // step needs to know which positions were empty.
  knockoutByes          Json?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([competitionId, name])
  @@unique([competitionId, slug])
  // Phase 1 Stage 5.4B: lets a child table's FK be composite - (organizationId, divisionId) ->
  // Division(organizationId, id) - so the database itself rejects a division reference whose
  // organizationId doesn't match the referencing row's own, not just RLS/application checks. See
  // SeasonClub's own doc comment for the full reasoning.
  @@unique([organizationId, id])
}

