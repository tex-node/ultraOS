model AuditLog {
  id             String       @id @default(cuid())
  organizationId String       @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  action         String
  entityType     String
  entityId       String
  details        Json?
  createdAt      DateTime     @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

model ContentTemplate {
  id             String       @id @default(cuid())
  organizationId String       @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  competitionId  String?
  competition    Competition? @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  type           ContentType
  name           String
  textTemplate   String
  htmlTemplate   String
  isActive       Boolean      @default(true)
  version        Int          @default(1)
  jobs           ContentJob[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([competitionId, type, version])
  @@index([type, isActive])
}

model ContentJob {
  id             String           @id @default(cuid())
  organizationId String           @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  templateId     String
  template       ContentTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  requestedById  String
  requestedBy    User             @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  type           ContentType
  sourceType     String
  sourceId       String
  status         ContentJobStatus @default(PENDING)
  errorMessage   String?
  asset          ContentAsset?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([sourceType, sourceId])
  @@index([requestedById, createdAt])
}

model ContentAsset {
  id             String       @id @default(cuid())
  organizationId String       @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobId          String       @unique
  job            ContentJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  slug           String       @unique
  title          String
  textContent    String
  htmlContent    String
  graphicData    Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([createdAt])
}

// ============================================================================
// G.21 — AI VISION & PLAYER INTELLIGENCE FOUNDATION
//
// Core boundary this whole domain enforces: AI OBSERVES. HUMANS / THE CANONICAL GAME SYSTEM
// VERIFY. Nothing in this block ever writes Fixture.homeScore/awayScore, GameEvent's canonical
// fields (including the pre-existing x/y/courtZone - see GameEvent's own doc comment), PlayerStat,
// TeamStat, or Standing. VisionObservation/VisionTrack/VisionEventMatch are a strictly separate,
// clearly-labeled candidate domain - a CONFIRMED VisionObservation is still not a GameEvent.
// ============================================================================

enum VideoSourceType {
  FULL_GAME
  CAMERA_ISO
  BROADCAST_PROGRAM
  PHONE_RECORDING
  TRAINING_CLIP
  HIGHLIGHT_CLIP
}

// Part LVI: a separate completeness axis from GameDataCapability (BOX_SCORE_ONLY/EVENT_LEVEL/
// FULL_ULTRA), which describes canonical game-data depth and must never be redefined by AI
// activity. This describes how far the VIDEO/VISION pipeline has progressed for a given
// GameVideo - entirely independent of what basketball-truth capability the game itself has.
enum VisionCapability {
  NO_VISION
  VIDEO_REGISTERED
  VISION_ANALYZED
  VISION_REVIEWED
  SPATIAL_TRACKING
}

enum TimelineAnchorSource {
  MANUAL
  AUTO_DETECTED
}

enum VisionAnalysisRunStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// Deliberately not exhaustive of every future basketball event - only what this track actually
// implements observation storage for (Part XII: "do NOT name every future basketball event in
// v1 unless actually implemented").
enum VisionObservationType {
  PERSON_DETECTED
  PLAYER_TRACK
  BALL_DETECTED
  SHOT_ATTEMPT_CANDIDATE
  SHOT_MADE_CANDIDATE
  REBOUND_CANDIDATE
  PASS_CANDIDATE
  COURT_POSITION
  JERSEY_NUMBER_CANDIDATE
}

enum VisionObservationStatus {
  PENDING
  MATCHED
  REJECTED
  CONFIRMED
  AMBIGUOUS
}

// Part XXVI: a deterministic MATCH SCORE band, not an opaque "AI confidence" figure - see
// vision-match-confidence.ts for the documented weighting that produces this.
enum VisionMatchBand {
  STRONG_MATCH
  POSSIBLE_MATCH
  AMBIGUOUS
  NO_MATCH
}

// Game Video Registry (Part V). Reuses MediaAsset for actual file storage/provenance/checksum -
// this model only adds video-specific metadata and the fixture/game association. A video does
// not have to live on the application server; MediaAsset's existing CLOUDFLARE_OBJECT_STORAGE
// provider already supports that.
model GameVideo {
  id                 String            @id @default(cuid())
  organizationId     String            @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fixtureId          String
  // Phase 1 Stage 5.2C: composite tenant-aware FK - registerGameVideoFromExistingAsset() was
  // previously a live, fully-unscoped write path that let a client-submitted fixtureId/
  // mediaAssetId pair attach a video to any organization's Fixture/MediaAsset with nothing to
  // stop it. Both required, onDelete stays CASCADE/RESTRICT. gameId (optional, ON DELETE
  // SetNull) is left as a simple FK for the same Prisma/Postgres composite+SetNull-on-a-
  // NOT-NULL-organizationId incompatibility Stage 5.2B-3 documented.
  fixture            Fixture           @relation(fields: [organizationId, fixtureId], references: [organizationId, id], onDelete: Cascade)
  gameId             String?
  game               Game?             @relation(fields: [gameId], references: [id], onDelete: SetNull)
  mediaAssetId       String            @unique
  mediaAsset         MediaAsset        @relation(fields: [organizationId, mediaAssetId], references: [organizationId, id], onDelete: Restrict)
  sourceType         VideoSourceType
  durationSeconds    Int?
  frameRate          Float?
  resolutionWidth    Int?
  resolutionHeight   Int?
  // When actual recording started, in real-world time - distinct from "video time" (elapsed ms
  // from the start of the file), which is what timeline anchors are expressed in.
  recordingStartedAt DateTime?
  cameraLabel        String?
  // Whether this video is eligible for AI analysis at all - an operator can register a video
  // (e.g. a low-quality phone clip) without ever queuing it for vision processing.
  analysisEligible   Boolean           @default(true)
  visionCapability   VisionCapability  @default(VIDEO_REGISTERED)
  // G.22 Part IX-XIII: the practical ingestion pipeline deferred by G.21. REGISTERED (default) ->
  // PROBING -> PROBE_FAILED | READY_FOR_ALIGNMENT (probe succeeded, no proxy yet or proxy not
  // needed) -> PROXY_GENERATING -> PROXY_FAILED | READY_FOR_ANALYSIS. Never advanced by a web
  // request - see VISION_WORKER_ARCHITECTURE.md.
  ingestStatus       VideoIngestStatus @default(REGISTERED)
  // Technical metadata a real media probe (ffprobe or equivalent) would populate - byteSize and
  // checksum are deliberately NOT duplicated here (they already live on the related MediaAsset;
  // Part V's "do not create duplicated court truth" applies equally to media truth).
  codec              String?
  container          String?
  hasAudio           Boolean?
  probedAt           DateTime?
  probeError         String?
  registeredById     String
  registeredBy       User              @relation("GameVideoRegisteredBy", fields: [registeredById], references: [id], onDelete: Restrict)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  anchors             VideoTimelineAnchor[]
  calibration         CourtCalibration?
  analysisRuns        VisionAnalysisRun[]
  observations        VisionObservation[]
  tracks              VisionTrack[]
  trajectoryArtifacts VisionTrajectoryArtifact[]
  spatialSummaries    VisionSpatialSummary[]

  // Required by Prisma for the composite @relation above (a 1:1 relation must expose the FK
  // pair as a unique constraint on the defining side) - mediaAssetId's own bare @unique already
  // guarantees the real 1:1 cardinality.
  @@unique([organizationId, mediaAssetId])
  @@index([fixtureId])
  @@index([gameId])
  @@index([visionCapability])
}

// Manual Sync Anchors (Part VIII) + the auto-detection extension point (Part XI). An
// AUTO_DETECTED anchor is never itself canonical - `accepted` starts false for those and only
// becomes true via an explicit operator review action, exactly the "AUTO-DETECTED ANCHOR ->
// REVIEW -> ACCEPT -> CANONICAL VIDEO ANCHOR" workflow the track specifies.
model VideoTimelineAnchor {
  id               String               @id @default(cuid())
  organizationId   String               @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gameVideoId      String
  gameVideo        GameVideo            @relation(fields: [gameVideoId], references: [id], onDelete: Cascade)
  videoTimeMs      Int
  period           Int
  gameClockSeconds Int
  source           TimelineAnchorSource @default(MANUAL)
  confidence       Float?
  accepted         Boolean              @default(true)
  createdById      String
  createdBy        User                 @relation("VideoTimelineAnchorCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime             @default(now())

  @@index([gameVideoId, videoTimeMs])
}

// Court Calibration (Part XVI-XVII). One calibration per video for now (Part XVI notes
// reusability across a fixed camera is desirable, but reusing a calibration safely requires
// verifying the camera genuinely didn't move between games - not attempted this track; every
// video gets its own explicit calibration instead of assuming reuse is safe).
model CourtCalibration {
  id                     String       @id @default(cuid())
  organizationId         String       @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gameVideoId            String       @unique
  gameVideo              GameVideo    @relation(fields: [gameVideoId], references: [id], onDelete: Cascade)
  // [{ imageX, imageY, courtX, courtY }, ...] - the point correspondences a homography is fit
  // from. See COURT_CALIBRATION.md for the coordinate system definition.
  referencePoints        Json
  basketLocations        Json?
  // Real-world court dimensions are NOT filled in for Season Zero - no canonical court geometry
  // (length/width/4PT boundary) is defined anywhere in this codebase (audited: game-rules.ts's
  // ULTRA_RULES has no spatial fields, Venue has no court dimensions). Left null rather than
  // guessed; see COURT_CALIBRATION.md's "what is and isn't defined" section.
  courtWidthUnits        Float?
  courtLengthUnits       Float?
  units                  String       @default("meters")
  // G.22 Part XXVIII: computed by meanReprojectionError() (court-homography.ts) once the
  // homography is fit - how well the transform explains its own reference points. Null until a
  // calibration is actually computed (never guessed). qualityBand is the calibration-quality.ts
  // classification of that error (HIGH/MEDIUM/LOW/FAILED) plus landmark coverage - every
  // downstream spatial metric inherits this band (Part XXVIII: "court metrics must inherit
  // calibration quality").
  reprojectionErrorUnits Float?
  qualityBand            String?
  createdById            String
  createdBy              User         @relation("CourtCalibrationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt              DateTime     @default(now())
}

// Model Registry (Part XV) - identity/version only, not an ML platform.
model VisionModel {
  id             String       @id @default(cuid())
  organizationId String       @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  key            String       @unique
  version        String
  description    String?
  configHash     String?
  createdAt      DateTime     @default(now())

  analysisRuns VisionAnalysisRun[]
}

// Analysis Run (Part XIV) - one row per model execution, for reproducibility. Never mutated in
// place by a later model version; a re-analysis is a new run, not an update to an old one.
model VisionAnalysisRun {
  id               String                  @id @default(cuid())
  organizationId   String                  @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gameVideoId      String
  gameVideo        GameVideo               @relation(fields: [gameVideoId], references: [id], onDelete: Cascade)
  visionModelId    String
  visionModel      VisionModel             @relation(fields: [visionModelId], references: [id], onDelete: Restrict)
  status           VisionAnalysisRunStatus @default(QUEUED)
  configHash       String?
  requestedById    String
  requestedBy      User                    @relation("VisionAnalysisRunRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  startedAt        DateTime?
  completedAt      DateTime?
  observationCount Int                     @default(0)
  errorMessage     String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  observations           VisionObservation[]
  tracks                 VisionTrack[]
  visionSpatialSummaries VisionSpatialSummary[]
  trajectoryArtifacts    VisionTrajectoryArtifact[]

  @@index([gameVideoId, status])
}

// Tracking Foundation (Part XX). A track is a temporal identity hypothesis ("likely the same
// detected person across frames") - NEVER player identity itself. playerCandidatePlayerId is a
// candidate, always paired with identityConfidence, always subject to human review.
model VisionTrack {
  id                        String            @id @default(cuid())
  organizationId            String            @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization              Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gameVideoId               String
  gameVideo                 GameVideo         @relation(fields: [gameVideoId], references: [id], onDelete: Cascade)
  analysisRunId             String
  analysisRun               VisionAnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  startVideoTimeMs          Int
  endVideoTimeMs            Int
  teamCandidateSeasonClubId String?
  playerCandidatePlayerId   String?
  playerCandidatePlayer     Player?           @relation("VisionTrackPlayerCandidate", fields: [playerCandidatePlayerId], references: [id], onDelete: SetNull)
  identityConfidence        Float?
  createdAt                 DateTime          @default(now())

  observations VisionObservation[]

  @@index([gameVideoId])
  @@index([analysisRunId])
}

// Vision Observation Model (Part XII-XIII) - the central architectural boundary of this track.
// Every field here is a CANDIDATE, never truth. playerCandidatePlayerId/teamCandidateSeasonClubId/
// jerseyCandidateNumber/eventCandidateType are all explicitly named "candidate" so no future
// caller mistakes this for a verified attribution the way a GameEvent's fields are.
model VisionObservation {
  id                        String                  @id @default(cuid())
  organizationId            String                  @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization              Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  analysisRunId             String
  analysisRun               VisionAnalysisRun       @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  gameVideoId               String
  gameVideo                 GameVideo               @relation(fields: [gameVideoId], references: [id], onDelete: Cascade)
  trackId                   String?
  track                     VisionTrack?            @relation(fields: [trackId], references: [id], onDelete: SetNull)
  videoTimeMs               Int
  videoTimeEndMs            Int?
  observationType           VisionObservationType
  // Normalized [0,1] image-space box: { x, y, width, height }. Null for observation types that
  // aren't a single-frame detection (e.g. an aggregated jersey candidate).
  boundingBox               Json?
  // Court-space coordinates, only populated when a CourtCalibration exists for this video and
  // the observation includes a court-position estimate. See COURT_CALIBRATION.md.
  courtX                    Float?
  courtY                    Float?
  teamCandidateSeasonClubId String?
  playerCandidatePlayerId   String?
  playerCandidatePlayer     Player?                 @relation("VisionObservationPlayerCandidate", fields: [playerCandidatePlayerId], references: [id], onDelete: SetNull)
  jerseyCandidateNumber     Int?
  eventCandidateType        String?
  confidence                Float
  rawMetadata               Json?
  status                    VisionObservationStatus @default(PENDING)
  // G.22 Part LII: set by a reviewer alongside REJECTED/AMBIGUOUS - structured, queryable
  // categories for the model-improvement backlog, rather than only free-text reasons.
  failureCategory           VisionFailureCategory?
  createdAt                 DateTime                @default(now())

  eventMatches VisionEventMatch[]

  @@index([gameVideoId, videoTimeMs])
  @@index([analysisRunId])
  @@index([status])
  @@index([observationType])
}

// Event Match Model (Part XXV-XXVI) - the ground-truth bridge. One VisionObservation may have
// zero, one, or several candidate VisionEventMatch rows (ambiguity is represented, never forced
// into a single guess). matchBand is a deterministic score band, not "AI confidence" - see
// vision-match-confidence.ts.
model VisionEventMatch {
  id              String                  @id @default(cuid())
  organizationId  String                  @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  observationId   String
  observation     VisionObservation       @relation(fields: [observationId], references: [id], onDelete: Cascade)
  gameEventId     String
  gameEvent       GameEvent               @relation(fields: [gameEventId], references: [id], onDelete: Cascade)
  matchBand       VisionMatchBand
  temporalErrorMs Int?
  playerMatch     Boolean?
  teamMatch       Boolean?
  eventTypeMatch  Boolean?
  confidence      Float
  reviewStatus    VisionObservationStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  reviewReason    String?
  failureCategory VisionFailureCategory?
  createdAt       DateTime                @default(now())

  @@unique([observationId, gameEventId])
  @@index([gameEventId])
  @@index([observationId])
  @@index([reviewStatus])
}

// Spatial Summaries (Part XXXVII) - the ONLY vision spatial data this track persists in
// PostgreSQL. Raw per-frame trajectories are deliberately NOT modeled here - see
// HIGH_FREQUENCY_DATA_STORAGE.md for why (a 30fps game x 10 players can produce millions of
// rows; this track made an explicit decision not to do that to the primary OLTP database without
// a real, evaluated pipeline producing that volume of data first).
model VisionSpatialSummary {
  id                   String            @id @default(cuid())
  organizationId       String            @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gameVideoId          String
  gameVideo            GameVideo         @relation(fields: [gameVideoId], references: [id], onDelete: Cascade)
  analysisRunId        String
  analysisRun          VisionAnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  playerId             String?
  player               Player?           @relation(fields: [playerId], references: [id], onDelete: SetNull)
  averageCourtX        Float?
  averageCourtY        Float?
  distanceCoveredUnits Float?
  samplesUsed          Int
  quality              String
  createdAt            DateTime          @default(now())

  @@index([gameVideoId])
  @@index([playerId])
}

// ============================================================================
// G.22 — EMPIRICAL AI VISION VALIDATION & ULTRA COURT INTELLIGENCE
//
// Builds on G.21's architecture. Same rule: AI observes, humans/canonical truth verify.
// CourtSpecification/VisionTrajectoryArtifact are additive, read-only-from-canonical-truth's
// perspective - nothing here can be referenced BY Fixture/Game/GameEvent/PlayerStat/TeamStat/
// Standing, only the reverse.
// ============================================================================

// Part IV-V: physical court geometry, honestly incomplete. A row existing here does NOT mean
// official geometry is known - `status` distinguishes an operator's in-progress DRAFT
// configuration from a confirmed OFFICIAL one, and every geometry field is nullable because no
// real Ultra Basketball court dimensions are known anywhere in this codebase as of G.22 (audited
// again - ULTRA_RULES, RuleSet, Venue all still have zero spatial fields). Tied to Venue, not
// RuleSet - physical court dimensions are a property of a physical place, not a rule variant;
// the 4PT RULE (which zone qualifies) stays owned by RuleSet.fourPointDefinitionType, unchanged
// from G.21 - this avoids duplicating court truth (Part V) by keeping "how big is the court" and
// "which part of it counts for 4PT" as two different, separately-versioned concerns.
enum CourtSpecificationStatus {
  DRAFT
  OFFICIAL
}

enum CourtBasketSide {
  A
  B
}

model CourtSpecification {
  id                 String                   @id @default(cuid())
  organizationId     String                   @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  venueId            String
  venue              Venue                    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  version            Int                      @default(1)
  status             CourtSpecificationStatus @default(DRAFT)
  courtLengthUnits   Float?
  courtWidthUnits    Float?
  units              String                   @default("meters")
  // Free-text description of what (0,0) represents in this specification's coordinate frame -
  // deliberately text, not assumed, since no single Ultra-wide convention exists yet (see
  // ULTRA_COURT_SPECIFICATION.md).
  originDescription  String?
  basketACourtX      Float?
  basketACourtY      Float?
  basketBCourtX      Float?
  basketBCourtY      Float?
  halfCourtX         Float?
  paintGeometry      Json?
  threePointGeometry Json?
  // The Ultra 4PT rule's actual spatial boundary - see FOUR_POINT_SPATIAL_RULE.md. Null unless
  // an operator has entered a real, confirmed geometry; four-point-spatial-rule.ts's pure
  // function refuses to evaluate QUALIFIES/DOES_NOT_QUALIFY without both this AND status=OFFICIAL.
  fourPointGeometry  Json?
  effectiveSeasonId  String?
  effectiveSeason    Season?                  @relation(fields: [effectiveSeasonId], references: [id], onDelete: SetNull)
  createdById        String
  createdBy          User                     @relation("CourtSpecificationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@unique([venueId, version])
  @@index([venueId, status])
}

// Part IX-XIII: practical video-ingestion pipeline states, never advanced by a web request.
enum VideoIngestStatus {
  REGISTERED
  PROBING
  PROBE_FAILED
  PROXY_GENERATING
  PROXY_FAILED
  READY_FOR_ALIGNMENT
  READY_FOR_ANALYSIS
}

// Part LII: structured failure categories for the model-improvement backlog - set by a reviewer
// alongside REJECTED/AMBIGUOUS, queryable across observations and event matches, never inferred
// automatically.
enum VisionFailureCategory {
  FALSE_POSITIVE
  FALSE_NEGATIVE
  ID_SWITCH
  BAD_CALIBRATION
  JERSEY_ERROR
  TIMELINE_ERROR
  OCCLUSION
  AMBIGUOUS
}

// Part XXXI-XXXII: the Postgres side of G.21's high-frequency-storage decision, now actually
// implemented (the decision itself was made and documented in G.21; no raw trajectory data has
// ever been generated in this environment to populate it - see HIGH_FREQUENCY_DATA_STORAGE.md).
// Raw/high-frequency per-frame trajectory samples live in object storage (Parquet or another
// compact analytical format) as ONE artifact file per (video, analysis run, optionally track) -
// this table is only the metadata pointer + summary, never the samples themselves.
model VisionTrajectoryArtifact {
  id               String               @id @default(cuid())
  organizationId   String               @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gameVideoId      String
  gameVideo        GameVideo            @relation(fields: [gameVideoId], references: [id], onDelete: Cascade)
  analysisRunId    String
  analysisRun      VisionAnalysisRun    @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  storageProvider  MediaStorageProvider
  objectKey        String
  format           String               @default("jsonl")
  checksumSha256   String
  byteSize         Int
  sampleCount      Int
  timeRangeStartMs Int
  timeRangeEndMs   Int
  // Which tracks/players this artifact covers, for discoverability without reading the file -
  // e.g. ["TRACK_001", "TRACK_002"]. Not a foreign key list (a track may not survive review).
  trackRefs        Json?
  filtered         Boolean              @default(false)
  filterMethod     String?
  createdAt        DateTime             @default(now())

  @@unique([storageProvider, objectKey])
  @@index([gameVideoId])
  @@index([analysisRunId])
}

// ============================================================================
// PHASE 1 — MULTI-TENANCY FOUNDATION
//
// Organization is the tenant root: one row per league this platform operates. Neon Ultra
// Basketball League (slug "neon-ultra") is the first and, as of Stage 3, the ONLY one -
// created and backfilled onto every existing row by Stage 2's script
// (scripts/phase1-stage2-backfill-organization.ts).
//
// Deliberately does NOT carry a sportId: sport selection already lives correctly on
// Competition, and one Organization may eventually run competitions in more than one sport
// (e.g. a future basketball + football league under one operator) - duplicating sport onto
// Organization would create two disagreeing sources of truth for "what sport is this," which
// this project has consistently avoided elsewhere (see CourtSpecification vs RuleSet in G.22).
//
// STAGE 3 TRACKED BRIDGE - READ BEFORE ONBOARDING A SECOND ORGANIZATION:
// Every tenant-scoped table's organizationId column has a database-level
// @default(dbgenerated("'<neon-ultra-org-id>'")). This was a deliberate choice, not an oversight
// - making the column required in Prisma's generated types without a default would have forced
// threading real session-derived organization context through every create call site across the
// app first (799 compile errors surfaced when this was tried), which is Stage 5's job, not
// Stage 3's. The default lets every existing, not-yet-org-aware code path keep compiling and
// working unchanged while NOT NULL + the foreign key become real and enforced at the database
// level today.
//
// This default is safe ONLY because Neon Ultra is still the only tenant that exists. The moment
// a second real Organization is onboarded, this default becomes a genuine footgun: any code path
// that forgets to pass organizationId explicitly would SILENTLY (not loudly) attribute new data
// to Neon Ultra instead of failing a compile or a query. Before onboarding organization #2:
// complete Stage 5 (thread real organization context through every create call site), then
// remove every one of these @default(dbgenerated(...)) annotations in a dedicated migration.
// ============================================================================

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

model Organization {
  id                        String                         @id @default(cuid())
  name                      String
  slug                      String                         @unique
  status                    OrganizationStatus             @default(ACTIVE)
  // Phase 1 Stage 5.4A: wired up in public-ids.ts. PublicIdCounter's sequence allocation is
  // tenant-local (each org allocates 1, 2, 3... independently, never advancing another org's
  // counter) - the formatted external id's platform-wide uniqueness now rests entirely on no two
  // organizations ever sharing a prefix, which is why both are @unique here. Do not let a new
  // organization reuse an existing prefix.
  idPrefixAthlete           String                         @unique @default("UBA")
  idPrefixStaff             String                         @unique @default("UBS")
  roleAssignments           UserRoleAssignment[]
  gameControlGrants         GameControlGrant[]
  competitions              Competition[]
  divisions                 Division[]
  seasons                   Season[]
  clubs                     Club[]
  seasonClubs               SeasonClub[]
  athletes                  Athlete[]
  players                   Player[]
  athleteAwards             AthleteAward[]
  athleteVideos             AthleteVideo[]
  trainingSessions          TrainingSession[]
  athleteTrainingRecords    AthleteTrainingRecord[]
  athleteTrainingMetrics    AthleteTrainingMetric[]
  athleteMedias             AthleteMedia[]
  mediaAssets               MediaAsset[]
  mediaAssetVariants        MediaAssetVariant[]
  mediaAssetUsages          MediaAssetUsage[]
  participantDocuments      ParticipantDocument[]
  staffs                    Staff[]
  drafts                    Draft[]
  draftPicks                DraftPick[]
  draftEvents               DraftEvent[]
  draftSquads               DraftSquad[]
  draftSquadMembers         DraftSquadMember[]
  draftCoachPoolEntrys      DraftCoachPoolEntry[]
  draftAllocations          DraftAllocation[]
  operationalChecklists     OperationalChecklist[]
  operationalChecklistItems OperationalChecklistItem[]
  incidents                 Incident[]
  runbooks                  Runbook[]
  runbookTasks              RunbookTask[]
  operatorMessages          OperatorMessage[]
  displayHeartbeats         DisplayHeartbeat[]
  rehearsals                Rehearsal[]
  equipments                Equipment[]
  eventStaffAssignments     EventStaffAssignment[]
  venueZones                VenueZone[]
  systemSettings            SystemSetting[]
  launchReadinessChecks     LaunchReadinessCheck[]
  opsTasks                  OpsTask[]
  opsNotifications          OpsNotification[]
  opsDocuments              OpsDocument[]
  venues                    Venue[]
  events                    Event[]
  registrationForms         RegistrationForm[]
  registrationFields        RegistrationField[]
  registrationSubmissions   RegistrationSubmission[]
  registrationParticipants  RegistrationParticipant[]
  participantSports         RegistrationParticipantSport[]
  eventDebriefs             EventDebrief[]
  eventVendorReviews        EventVendorReview[]
  eventVolunteerReviews     EventVolunteerReview[]
  announcements             Announcement[]
  wellWishs                 WellWish[]
  venueSections             VenueSection[]
  seatZones                 SeatZone[]
  seatReservations          SeatReservation[]
  tickets                   Ticket[]
  accreditations            Accreditation[]
  applications              Application[]
  adminOfflineIntakes       AdminOfflineIntake[]
  publicIdCounters          PublicIdCounter[]
  publicIdAliass            PublicIdAlias[]
  publicResourceLocators    PublicResourceLocator[]
  publicTokenLocators       PublicTokenLocator[]
  importJobs                ImportJob[]
  importRows                ImportRow[]
  vendors                   Vendor[]
  mediaProfiles             MediaProfile[]
  volunteerProfiles         VolunteerProfile[]
  vendorProducts            VendorProduct[]
  vendorInventorys          VendorInventory[]
  orders                    Order[]
  orderItems                OrderItem[]
  checkIns                  CheckIn[]
  promoCodes                PromoCode[]
  sponsorCampaigns          SponsorCampaign[]
  fixtures                  Fixture[]
  fixtureOfficials          FixtureOfficial[]
  games                     Game[]
  ruleSets                  RuleSet[]
  gameRuleSnapshots         GameRuleSnapshot[]
  gamePeriodScores          GamePeriodScore[]
  gameEvents                GameEvent[]
  gameStarters              GameStarter[]
  playerStats               PlayerStat[]
  teamStats                 TeamStat[]
  standings                 Standing[]
  noveltyTeams              NoveltyTeam[]
  noveltyMatchs             NoveltyMatch[]
  noveltyGames              NoveltyGame[]
  noveltyGameEvents         NoveltyGameEvent[]
  noveltyPlayerStats        NoveltyPlayerStat[]
  fanClubs                  FanClub[]
  fanMemberships            FanMembership[]
  scoutReports              ScoutReport[]
  mVPVotes                  MVPVote[]
  auditLogs                 AuditLog[]
  contentTemplates          ContentTemplate[]
  contentJobs               ContentJob[]
  contentAssets             ContentAsset[]
  gameVideos                GameVideo[]
  videoTimelineAnchors      VideoTimelineAnchor[]
  courtCalibrations         CourtCalibration[]
  visionModels              VisionModel[]
  visionAnalysisRuns        VisionAnalysisRun[]
  visionTracks              VisionTrack[]
  visionObservations        VisionObservation[]
  visionEventMatchs         VisionEventMatch[]
  visionSpatialSummarys     VisionSpatialSummary[]
  courtSpecifications       CourtSpecification[]
  visionTrajectoryArtifacts VisionTrajectoryArtifact[]
  sportDefinitionOverrides  SportDefinitionOverride[]
  entrants                  Entrant[]
  entrantMembers            EntrantMember[]
  gameMetricValues          GameMetricValue[]
  standingMetrics           StandingMetric[]
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt

  @@index([status])
}
