model Draft {
  id             String       @id @default(cuid())
  organizationId String       @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  seasonId       String
  season         Season       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  divisionId     String
  division       Division     @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  tier           DraftTier    @default(MAIN)
  status         DraftStatus  @default(NOT_STARTED)
  currentRound   Int          @default(1)
  nextPickNumber Int          @default(1)
  // Optional link to the governing DraftEvent. When set, Draft/DraftPick's
  // REHEARSAL-vs-LIVE behavior is derived from draftEvent.operatingMode —
  // this is what lets Secondary Draft (Draft/DraftPick) participate in the
  // same rehearsal-isolation guarantees as the Main Draft (DraftEvent/
  // DraftAllocation) instead of being a separate, unguarded system. A Draft
  // with no linked DraftEvent is always treated as REHEARSAL (never writes
  // official Player.seasonClubId) — the safe default.
  draftEventId   String?
  draftEvent     DraftEvent?  @relation(fields: [draftEventId], references: [id], onDelete: SetNull)
  startedAt      DateTime?
  completedAt    DateTime?
  picks          DraftPick[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([seasonId, divisionId, name])
  @@index([seasonId, divisionId, tier, status])
  @@index([draftEventId])
}

enum DraftPickStatus {
  RESERVED
  REVEALING
  REVEALED
  CONFIRMED
  CORRECTED
}

model DraftPick {
  id               String                  @id @default(cuid())
  organizationId   String                  @default(dbgenerated("'cmt4odhgn0000wokk8fbwr6ro'"))
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  draftId          String
  draft            Draft                   @relation(fields: [draftId], references: [id], onDelete: Cascade)
  round            Int
  pickNumber       Int
  seasonClubId     String
  seasonClub       SeasonClub              @relation(fields: [seasonClubId], references: [id], onDelete: Restrict)
  playerId         String
  player           Player                  @relation(fields: [playerId], references: [id], onDelete: Restrict)
  // Recorded at creation time and never changed afterward — the permanent,
  // immutable record of whether this specific pick was made under REHEARSAL
  // or LIVE, independent of whatever the Draft/DraftEvent's mode is later
  // changed to. Mirrors DraftAllocation.operatingMode.
  operatingMode    DraftEventOperatingMode @default(REHEARSAL)
  status           DraftPickStatus         @default(RESERVED)
  reservedAt       DateTime                @default(now())
  revealedAt       DateTime?
  confirmedAt      DateTime?
  correctedAt      DateTime?
  correctionReason String?
  // Nullable: legacy/seed DraftPick rows created before this column existed
  // have no recorded actor. All new picks created through
