DATABASE_URL="postgresql://ultra:change-me@localhost:5432/ultraleagueos?schema=public"
AUTH_SECRET="replace-with-a-long-random-value"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID="google-oauth-client-id"
AUTH_GOOGLE_SECRET="google-oauth-client-secret"
R2_ACCOUNT_ID="cloudflare-account-id"
R2_ENDPOINT="https://cloudflare-account-id.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="r2-access-key-id"
R2_SECRET_ACCESS_KEY="r2-secret-access-key"
R2_BUCKET="ultraos-uploads"
R2_PUBLIC_BASE_URL=""
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-user"
SMTP_PASSWORD="smtp-password"
EMAIL_FROM="Ultra Basketball <noreply@example.com>"

# Bachs payment gateway (F5.3 for ticketing, v18 for subscription billing). Server-side only; never expose the key to
# the browser. BACHS_* are the documented names; BACH_IO / BACH_WEBHOOK are the legacy names the ticketing integration
# was built with and are still read as a fallback, so an environment configured either way keeps working.
BACHS_API_BASE="https://api.bachs.io"
BACHS_KEY="sk_live_replace-me"
BACHS_WEBHOOK_SECRET="whsec_replace-me"
BACH_API_BASE="https://api.bachs.io"
BACH_IO="sk_live_replace-me"
BACH_WEBHOOK="whsec_replace-me"

# Subscription billing (streak v18). The Bachs product ids that represent each paid plan - a plan is a product in Bachs,
# which is why a checkout carries a product_cart rather than an amount. Settlement defaults to NGN.
BACHS_PRODUCT_PRO="prod_replace-me"
BACHS_PRODUCT_ENTERPRISE="prod_replace-me"
BACHS_SETTLEMENT_CURRENCY="NGN"

# Seeded only in non-production environments.
SEED_ADMIN_EMAIL="admin@neonultra.ng"
SEED_ADMIN_PASSWORD="change-me-before-use"

# ============================================================================
# FEATURE FLAGS
#
# Every one of these is read at REQUEST time by the server. A flag that is missing from a fresh host
# silently means "off" - which is how the coaching stack shipped dark for a day after it was deployed to
# production. Keep this list in sync with the code and with deploy/README.md.
# ============================================================================

# P13 offline scoring (Workstream A). Defaults to off in production.
# Client-visible (NEXT_PUBLIC_): it gates the offline capture UI in the browser bundle.
NEXT_PUBLIC_OFFLINE_SCORING_ENABLED="false"

# P15 coaching stack (I2 selection advisor, I3 training loop, I6 passport).
# Server-side only, deliberately NOT NEXT_PUBLIC_: the coaching pages are Server Components and the flag
# must never be readable from a public bundle. ADR-011 ships the feature dark; set to "true" to enable
# every /coaching route. Production has "true" since 2026-10-18.
COACHING_ASSISTANT_ENABLED="false"

# ============================================================================
# OPTIONAL / OPERATIONAL (safe to leave unset; the defaults are written down)
# ============================================================================

# Media storage. Absent -> local filesystem under <cwd>/.media (or /opt/ultraos-staging/shared/media when
# the app runs from that path). Set MEDIA_STORAGE_PROVIDER to R2 in production and fill the R2_* block.
# MEDIA_STORAGE_PROVIDER="LOCAL_PERSISTENT_STORAGE"
# MEDIA_LOCAL_ROOT="/opt/ultraleagueos/shared/media"
# MEDIA_PUBLIC_BASE_URL=""

# Scoresheet OCR (P15 I1 image path; the CSV/XLSX path does not need it).
# TESSERACT_BINARY="tesseract"
# OCR_PREPROCESS="off"          # "off" disables the upscale/median/sharpen preprocessing

# Vision worker (P15 I4). The Python service in services/vision; 8010 avoids the Kong gateway on 8000 on
# the staging host. Ingest works without it (the GameVideo row is READY_FOR_ANALYSIS and the worker's
# poller collects it later).
# VISION_WORKER_URL="http://127.0.0.1:8010"
# VISION_WORKER_TOKEN=""        # sent as a Bearer token when the worker sits behind an authenticating proxy

# --- partner data feed (streak v6) ----------------------------------------------------------
# Shared secret for GET /api/cron/drain-feeds, called by the systemd timer every 30s. The route fails
# CLOSED: unset means 503 and nothing drains, so a host that forgets this cannot expose an endpoint that
# makes the server POST to partner webhook URLs. Generate: openssl rand -hex 32
# Install the timer: deploy/ops/install-feed-drain-timer.sh <app-root> <port> <staging|production>
CRON_SECRET=