# Local E2E environment. Committed on purpose: none of these values are secrets, and a developer should be able to run the
# browser suite without being handed credentials. Nothing here is valid outside 127.0.0.1.
DATABASE_URL="postgresql://ultraos:test@127.0.0.1:55432/ultraleagueos_test"

# Test-only signing key. Sessions created here cannot be replayed against a real deployment because the secret differs.
AUTH_SECRET="test-only-secret-not-for-production"

AUTH_URL="http://127.0.0.1:4173"
NEXTAUTH_URL="http://127.0.0.1:4173"
NEXT_PUBLIC_APP_URL="http://127.0.0.1:4173"

# Billing must never reach the real provider from a test run.
BACHS_MOCK=1
BACHS_SETTLEMENT_CURRENCY="USD"

# The coaching subtree 404s unless the flag is on, and the multi-tenant spec walks into it.
COACHING_ASSISTANT_ENABLED=true

# The organization the harness seeds and hands to the preparation scripts.
E2E_ORG_SLUG="e2e-league"

# Test-only value for the local e2e suite: the harness never starts the agent, so this is only ever used to sign proofs the agent
# would verify if it were running.
AGENT_SECRET="test-only-agent-secret"
