[Unit]
Description=Copy newest backups to Cloudflare R2 (off-site)
Documentation=file:/root/raivstream/README.ops.md
After=network-online.target
Wants=network-online.target
OnFailure=backup-alert@%n.service

[Service]
Type=oneshot
User=root
ExecStart=/root/raivstream/scripts/backup-offsite.sh

[Install]
WantedBy=multi-user.target
