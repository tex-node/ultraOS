# Vision stack configuration — TEMPLATE. Copy to /opt/ultraos-vision/vision.env, fill in, chmod 600.
#
# WHY THIS FILE IS NOT IN THE CHECKOUT (streak v25, Prompt 1): every web deploy runs `git clean -fdx` in
# /opt/ultraos-staging/source, which deletes untracked files. The v24 `.env` lived there and was silently deleted; the
# running containers kept working, so the breakage only showed up when `docker compose up -d` was next attempted — and it
# would have shown up at the next reboot. The real file lives at /opt/ultraos-vision/vision.env, outside any checkout, and
# docker-compose.yml reads it through VISION_ENV_FILE.

DATABASE_URL="postgresql://<app role>:<password>@172.17.0.1:5433/ultraos_staging"
CELERY_BROKER_URL="redis://vision-redis:6379/0"
CELERY_RESULT_BACKEND="redis://vision-redis:6379/1"

# Real inference (not the stub). /health reports this string.
VISION_ANALYZER=yolov8n-person
VISION_API_PORT=8010
VISION_REDIS_PORT=6380
VISION_LOG_LEVEL=info

# Where MediaAsset objectKey values resolve INSIDE the containers (read-only mount).
VISION_MEDIA_ROOT=/media
# The host directory mounted at /media. Required: compose refuses to start without it.
VISION_MEDIA_DIR=/opt/ultraos-staging/shared/media

# The app's R2 bucket, so generated clips use the same storage as the web app.
MEDIA_STORAGE_PROVIDER=R2
MEDIA_S3_BUCKET="<r2 bucket>"
MEDIA_S3_ACCESS_KEY_ID="<r2 key id>"
MEDIA_S3_SECRET_ACCESS_KEY="<r2 secret>"
MEDIA_S3_ENDPOINT="https://<account id>.r2.cloudflarestorage.com"
MEDIA_PUBLIC_BASE_URL="<public base url>"
