# B0 (P14 / Workstream B) - vision service configuration.
# Copy to .env and fill in. Never commit real secrets.

# --- Database ---
# Reuses the app's Postgres. The service is scoped to Vision tables only.
DATABASE_URL="postgresql://ultra:change-me@host.docker.internal:5432/ultraleagueos?schema=public"

# --- Queue ---
CELERY_BROKER_URL="redis://vision-redis:6379/0"
CELERY_RESULT_BACKEND="redis://vision-redis:6379/1"

# --- Object storage (video segments) ---
# Reuses the app's R2/S3 credentials. B0 uses the adapter stub; B2 pulls real segments.
MEDIA_S3_ENDPOINT=""
MEDIA_S3_BUCKET=""
MEDIA_S3_ACCESS_KEY_ID=""
MEDIA_S3_SECRET_ACCESS_KEY=""

# --- Service ---
VISION_API_PORT=8000
VISION_REDIS_PORT=6380
VISION_LOG_LEVEL=info
# When true, the analyzer is the deterministic stub (no model). B0 default.
VISION_ANALYZER=stub
