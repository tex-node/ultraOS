# Shell scripts and Docker/compose files must keep LF on every platform.
#
# WHY (streak v26): the working copy on Windows had CRLF in deploy/deploy.sh, and copying that file to the host produced
#
#   /root/deploy.sh: line 36: syntax error near unexpected token `$'in\r''
#
# which broke the production deploy script until it was restored from backup. `.gitattributes` cannot fix a file that has
# already been copied, but it stops the working tree from producing CRLF in the first place.
* text=auto eol=lf

*.sh            text eol=lf
*.bash          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Dockerfile      text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.conf          text eol=lf

# Windows-only files, if any ever appear, keep their endings.
*.ps1           text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf
